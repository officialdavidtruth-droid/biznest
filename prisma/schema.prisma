// ============================================================================
// BizNest -- Prisma Schema
// This file is the single source of truth for the data model. It is split
// conceptually (via comments) into the subsystems described in the product
// spec. Build phases 2+ should extend these models rather than create
// parallel ones.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// AUTH & USERS
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  MEMBER // a plain BizNest account for browsing and following businesses: no store, no dashboard, no profile
  STORE_OWNER
  PLATFORM_ADMIN
  SUPPORT_MODERATOR
}

model User {
  id                String    @id @default(cuid())
  name              String?
  // No longer globally @unique -- see customerScopeStoreId below. Owners,
  // staff, and platform admins keep a single global identity (scope null)
  // and remain unique among themselves; a customer account is scoped to
  // one specific store, so the same email can independently register as a
  // completely separate account (own password, own identity) at any
  // number of different stores. Enforced by the composite unique index
  // below, plus a partial unique index (added via raw SQL migration,
  // since Prisma's schema DSL can't express a WHERE-scoped unique index)
  // that keeps scope-null (platform) rows globally unique the same as
  // before.
  email             String
  // Null = a platform-level identity (store owner, staff, platform admin,
  // or a pending signup awaiting business verification -- see registerUser
  // in lib/actions/auth.ts). Set to a specific Store's id = this row is
  // that store's customer account for this email, fully independent from
  // any account of the same email at any other store.
  customerScopeStoreId String?
  customerScopeStore   Store?  @relation("UserCustomerScope", fields: [customerScopeStoreId], references: [id], onDelete: Cascade)
  browseTaggedIn       BrowsePostTag[] @relation("BrowseTaggedUser")
  // Splits the scope-null (platform) identity space in two: false = a main
  // BizNest account (store owner, staff, platform admin, or a pending
  // signup awaiting business verification -- see registerUser in
  // lib/actions/auth.ts); true = a BizNest Marketing account (see
  // signUpForMarketing in lib/actions/marketing-signup.ts). BizNest
  // Marketing is a fully separate product with its own accounts -- an
  // email already registered on the main platform must not block (or be
  // confused with) a Marketing signup of the same email, and vice versa.
  // Only meaningful when customerScopeStoreId is null; a store-scoped
  // customer row is already isolated by that store's id and this flag is
  // irrelevant to it. Enforced by the two partial unique indexes added in
  // prisma/migrations/20260921090000_split_marketing_identity_scope
  // (replacing the single scope-null partial index from
  // 20260823120000_customer_scoped_email).
  isMarketingOnly   Boolean   @default(false)
  emailVerified     DateTime?
  passwordHash      String? // null for OAuth-only accounts
  image             String?
  role              UserRole  @default(CUSTOMER)
  isBanned          Boolean   @default(false)
  bannedReason      String?
  // Bumped to "now" by the admin force-logout action. Any JWT issued before
  // this timestamp is rejected on its next use (see lib/auth.ts) -- this is
  // what makes "force logout" actually work under a JWT session strategy,
  // where there's no server-side session row to just delete.
  sessionsInvalidatedAt DateTime?
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  phone             String?
  // Stamped on every fresh sign-in of a platform identity (owner/staff).
  // Read by the churn-watch cron ("no logins for 7 days"). Null = never
  // signed in since this column was added.
  lastLoginAt       DateTime?
  // Set when the person unsubscribes from BizNest's own reminder and
  // promotional emails (not store newsletters, receipts or security mail).
  platformEmailOptOutAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  platformEmailLogs PlatformEmailLog[]

  // BizNest vendor referral program (see lib/referrals/vendor-referral.ts)
  vendorReferralCode        VendorReferralCode?
  vendorReferralsMade       VendorReferral[]           @relation("VendorReferralReferrer")
  vendorReferralOf          VendorReferral?            @relation("VendorReferralReferee")
  vendorReferralWithdrawals VendorReferralWithdrawal[]

  accounts          Account[]
  sessions          Session[]
  business          Business?
  orders            Order[]         @relation("BuyerOrders")
  bookings          Booking[]       @relation("BuyerBookings")
  storeWallets      StoreWallet[]
  reviews           Review[]
  reviewReportsMade ReviewReport[] @relation("ReviewReportedBy")
  reviewResponses   ReviewResponse[]
  messages          Message[]
  conversations     ConversationParticipant[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  staffMemberships  StoreStaff[]
  fnbShifts         FnbShift[]       @relation("FnbShiftStaff")
  auditLogs         AuditLog[]
  disputesRaised    Dispute[]       @relation("DisputeRaisedBy")
  disputeEvidence   DisputeEvidence[]

  // --- Customer account system (additive) ---
  addresses         Address[]
  storeAddresses    StoreCustomerAddress[]
  storeMemberships  StoreCustomer[]
  customerProfiles  StoreCustomerProfile[]
  wishlistItems     WishlistItem[]
  recentlyViewed    RecentlyViewed[]
  favoriteBusinesses FavoriteBusiness[]
  storeLoyaltyAccounts StoreLoyaltyAccount[]
  savedCarts        SavedCart[]

  // --- Referrals / gift cards (additive) ---
  referralCodes     ReferralCode[]
  referralsMade     Referral[]      @relation("ReferralReferrer")
  referralReceived  Referral[]      @relation("ReferralReferee")
  giftCardsPurchased GiftCard[]     @relation("GiftCardPurchaser")

  // --- Loyalty / invoicing / quotations (additive) ---
  loyaltyAccount    LoyaltyAccount?
  invoices          Invoice[]
  quotes            Quote[]

  @@index([role])
  // Enforces "unique email per scope": a store-scoped customer's email is
  // unique within that one store, independent of every other store. Note
  // this alone does NOT enforce uniqueness among scope-null (platform)
  // rows -- Postgres treats every NULL as distinct, so two owner accounts
  // could otherwise share an email. That's covered separately by a
  // partial unique index added via raw SQL in this same migration.
  @@unique([email, customerScopeStoreId])
  creativeProjects CreativeProject[]

}


model StoreCustomerAddress {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String   @default("Nigeria")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, userId])
  @@index([storeId, userId, isDefault])
}

model StoreLoyaltyAccount {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance Int            @default(0)
  entries       StoreLoyaltyEntry[]
  updatedAt     DateTime       @updatedAt

  @@unique([storeId, userId])
  @@index([storeId])
}

model StoreLoyaltyEntry {
  id                 String             @id @default(cuid())
  loyaltyAccountId   String
  loyaltyAccount     StoreLoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  orderId            String?
  order              Order?             @relation(fields: [orderId], references: [id])
  type               LoyaltyEntryType
  points             Int
  note               String?
  // Set on credits/debits created by the referral program so they can be
  // traced from the loyalty ledger back to the referral (and its order).
  referralId         String?
  referral           Referral?          @relation(fields: [referralId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())

  @@index([loyaltyAccountId, createdAt])
  @@index([orderId, type])
  @@index([referralId])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  // "Home", "Office"
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String   @default("Nigeria")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId, serviceId])
  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([userId, viewedAt])
}

model FavoriteBusiness {
  id         String   @id @default(cuid())
  storeId    String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

model SavedCart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     Json     // [{ productId, quantity }]
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
}

// A customer's account is scoped to the one store they signed up through —
// signing up with Store A does not grant sign-in access to Store B. This
// is separate from StoreStaff (which is store-scoped employment) and from
// User.role (a platform-level role like STORE_OWNER) -- this table is the
// one source of truth for "is this person actually a customer of this
// specific store", and lib/auth.ts's Credentials authorize() checks it on
// every store-context login.
model StoreCustomerProfile {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  notes     String?
  preferences Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  crmLeads  CrmLead[]

  @@index([storeId, createdAt])
  @@index([storeId, phone])
  @@index([storeId, email])
  @@index([userId])
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum CrmLeadSource {
  WEBSITE
  FORM
  WHATSAPP
  EMAIL
  PHONE
  BOOKING
  ORDER
  REFERRAL
  SOCIAL
  MANUAL
  OTHER
}

model CrmLead {
  id              String        @id @default(cuid())
  storeId         String
  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        StoreCustomerProfile? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name            String
  email           String?
  phone           String?
  company         String?
  source          CrmLeadSource @default(MANUAL)
  status          CrmLeadStatus @default(NEW)
  value           Decimal?      @db.Decimal(12, 2)
  currency        String        @default("NGN")
  notes           String?
  lastContactedAt DateTime?
  nextFollowUpAt  DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  activities      CrmActivity[]

  @@index([storeId, status])
  @@index([storeId, source])
  @@index([storeId, nextFollowUpAt])
  @@index([storeId, createdAt])
  @@index([storeId, email])
  @@index([storeId, phone])
}

model CrmActivity {
  id        String   @id @default(cuid())
  leadId    String
  lead      CrmLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  createdAt DateTime @default(now())

  @@index([leadId, createdAt])
}

model StoreCustomer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
}

// Auth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       VerificationTokenType @default(EMAIL)

  @@unique([identifier, token])
}

enum VerificationTokenType {
  EMAIL
  PASSWORD_RESET
  TWO_FACTOR
  ORDER_RECOVERY
}

// ----------------------------------------------------------------------------
// BUSINESS VERIFICATION (KYC)
// ----------------------------------------------------------------------------

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessRegistrationType {
  REGISTERED   // has a business registration certificate
  UNREGISTERED // requires ID + selfie + guarantors
}

model Business {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName          String
  category              String
  businessSubcategory   String?
  description           String                    @db.Text

  // What this business actually sells -- set once at onboarding and driving
  // which dashboard sections/storefront layout are shown. Hybrid stores
  // have both true; every business must have at least one true (enforced
  // in lib/validations/business.ts, not at the DB level, since Prisma
  // can't express a "not both false" constraint).
  sellsProducts         Boolean                   @default(true)
  offersServices        Boolean                   @default(false)
  phone                 String
  email                 String
  country               String
  state                 String
  city                  String

  registrationType      BusinessRegistrationType
  registrationCertUrl   String? // required if REGISTERED
  governmentIdUrl        String? // required if UNREGISTERED
  selfieUrl              String? // required if UNREGISTERED

  fraudPolicyAcceptedAt DateTime?

  verificationStatus    VerificationStatus        @default(PENDING)
  verificationBadge     Boolean                   @default(false)
  reviewedByAdminId     String?
  reviewedAt            DateTime?
  rejectionReason       String?

  // --- Marketplace discovery fields (additive; existing rows default in) ---
  latitude              Float?
  longitude             Float?
  // Search visibility, kept independent of verificationStatus/verificationBadge
  // so admins can suppress a business from platform-wide discovery without
  // touching its trust/verification record.
  searchVisible         Boolean                   @default(true)
  // Denormalized from Review, recomputed on review create/update/delete
  // (see lib/actions/reviews.ts) -- avoids aggregating Review on every
  // search request. Null/0 until the recompute job/backfill runs.
  avgRating             Float?
  reviewCount           Int                       @default(0)

  // Denormalized copy of getTrustScoreBreakdown(...).score (see
  // lib/actions/trust-score.ts). The dashboard still computes the full
  // breakdown live; this column exists only so marketplace search can
  // sort/filter by Trust Score without recomputing it per row. Kept in
  // sync by recomputeAndPersistTrustScore() -- see that file for which
  // write paths trigger a refresh and the accepted staleness window.
  trustScore            Int?
  trustScoreUpdatedAt   DateTime?
  guarantors             Guarantor[]
  store                  Store?
  favoritedBy            FavoriteBusiness[]

  createdAt              DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([verificationStatus])
  @@index([category])
  @@index([city, state])
  @@index([latitude, longitude])
  @@index([trustScore])
}

model Guarantor {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  fullName     String
  phone        String
  email        String
  governmentIdUrl String
  relationship String

  createdAt    DateTime @default(now())
}


enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DIRTY
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

enum GuestPresence {
  IN
  OUT
}

enum PropertyReservationStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PropertyPaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

enum RoomCardStatus {
  ACTIVE
  REVOKED
}

model PropertyGuest {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fullName    String
  email       String?
  phone       String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  reservations PropertyReservation[]
  accessCards RoomAccessCard[]
  folioCharges PropertyFolioCharge[]
  @@index([storeId])
}

model PropertyRoom {
  id          String     @id @default(cuid())
  storeId     String
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  roomType    String
  // The online-booking unit (ServiceUnit) that is this same physical room.
  // When set, front-desk reservations and OTA blocks on this room make the
  // unit unavailable online, and online bookings block this room in the PMS.
  // One-to-one: a physical room is never counted twice.
  serviceUnitId String?    @unique
  serviceUnit   ServiceUnit? @relation(fields: [serviceUnitId], references: [id], onDelete: SetNull)
  status      RoomStatus @default(AVAILABLE)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  reservations PropertyReservation[]
  accessCards RoomAccessCard[]
  channelConnections ChannelConnection[]
  channelBlocks ChannelBlock[]
  doorReaders DoorReader[]
  maintenanceTickets PropertyMaintenanceTicket[]
  @@unique([storeId, name])
  @@index([storeId, status])
}

model RoomAccessCard {
  id             String          @id @default(cuid())
  storeId        String
  store          Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  roomId         String
  room           PropertyRoom    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  reservationId  String?
  reservation    PropertyReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  guestId        String?
  guest          PropertyGuest?  @relation(fields: [guestId], references: [id], onDelete: SetNull)

  cardUid        String
  label          String?
  status         RoomCardStatus  @default(ACTIVE)
  activatedAt    DateTime        @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([storeId, cardUid])
  @@index([storeId, roomId, status])
  @@index([reservationId, status])
  @@index([guestId, status])
  @@index([expiresAt, status])
}

model PropertyReservation {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  guestId     String
  guest       PropertyGuest @relation(fields: [guestId], references: [id], onDelete: Restrict)
  roomId      String
  room        PropertyRoom @relation(fields: [roomId], references: [id], onDelete: Restrict)
  checkIn     DateTime
  checkOut    DateTime
  status      PropertyReservationStatus @default(PENDING)
  guestPresence GuestPresence @default(OUT)
  notes       String?
  checkedInAt DateTime?
  checkedOutAt DateTime?
  cancelledAt DateTime?

  // Deposit / stay-charge tracking. Nothing here forces a hotel to collect
  // payment through BizNest -- depositAmount stays null and paymentStatus
  // stays UNPAID unless a deposit is actually requested via
  // chargeReservationDeposit (see lib/actions/pms.ts) -- but if they do,
  // it settles through the same Paystack/Flutterwave webhook + callback
  // routes every other payment type in this app uses, rather than being
  // tracked ad hoc.
  depositAmount   Decimal? @db.Decimal(12, 2)
  paymentCurrency String?
  paymentStatus   PropertyPaymentStatus @default(UNPAID)
  paymentReference String? @unique
  // Set when this reservation mirrors an online (storefront) Booking, see lib/pms-online-sync.ts.
  bookingId       String? @unique
  payments        Payment[]
  accessCards     RoomAccessCard[]
  folioCharges    PropertyFolioCharge[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([storeId, checkIn, checkOut])
  @@index([storeId, status])
  @@index([roomId, checkIn, checkOut])
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
}

enum MaintenanceTicketStatus {
  OPEN
  RESOLVED
}

// A reported fault on a room. Persisted so the Maintenance tab survives a reload
// and keeps a history; room.status is only a label for "can I sell this room".
model PropertyMaintenanceTicket {
  id           String                  @id @default(cuid())
  storeId      String
  store        Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  roomId       String
  room         PropertyRoom            @relation(fields: [roomId], references: [id], onDelete: Cascade)
  description  String
  priority     MaintenancePriority     @default(MEDIUM)
  status       MaintenanceTicketStatus @default(OPEN)
  reportedById String?
  reportedAt   DateTime                @default(now())
  resolvedAt   DateTime?
  resolution   String?
  @@index([storeId, status, reportedAt])
  @@index([roomId, status])
}

enum PropertyFolioChargeStatus {
  OPEN
  PAID
  VOID
}

model PropertyFolioCharge {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reservationId String
  reservation   PropertyReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestId       String
  guest         PropertyGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  description   String
  category      String?
  quantity      Int      @default(1)
  unitAmount    Decimal  @db.Decimal(12, 2)
  amount        Decimal  @db.Decimal(12, 2)
  currency      String   @default("NGN")
  status        PropertyFolioChargeStatus @default(OPEN)
  postedAt      DateTime @default(now())
  paidAt        DateTime?
  voidedAt      DateTime?
  notes         String?
  // Set when the charge was posted from an existing bill (sourceType "INVOICE") or POS order
  // (sourceType "ORDER"), so the same bill can never be posted to a room twice.
  sourceType    String?
  sourceId      String?

  @@index([storeId, postedAt])
  @@index([storeId, reservationId, status])
  @@index([storeId, guestId, postedAt])
  @@index([storeId, sourceType, sourceId])
}

// ----------------------------------------------------------------------------
// STORE
// ----------------------------------------------------------------------------

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DomainStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

model Store {
  timezone      String      @default("Africa/Lagos")
  // Owner opt-in: also email the end-of-day summary (sales, stock risks, unpaid
  // checkouts). The in-app notification + push are always sent. See app/api/cron/daily-summary.
  dailySummaryEmail Boolean @default(false)
  // Owner opt-in: message the customer (WhatsApp, then SMS) automatically when a tailoring job changes stage.
  tailoringAutoNotify Boolean @default(false)
  // Owner opt-ins for automatic customer messages (WhatsApp first, SMS fallback; see lib/customer-messaging.ts).
  // Off by default because SMS costs money and customers should only hear from stores that chose this.
  msgOrderUpdates     Boolean @default(false)
  msgAbandonedCart    Boolean @default(false)
  msgReviewRequests   Boolean @default(false)
