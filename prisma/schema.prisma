  ownFlutterwaveSecretHash String?
  ownGatewayVerifiedAt     DateTime?
  // Set once a legacy subaccount's platform percentage has been zeroed at the
  // gateway (see neutralizeLegacySubaccountSplits). Null = not done yet.
  legacySplitZeroedAt      DateTime?

  // Running balance of platform commission owed from POS (cash/in-person)
  // sales. Online orders never touch this -- the gateway subaccount split
  // deducts commission automatically at charge time (see payments/page.tsx
