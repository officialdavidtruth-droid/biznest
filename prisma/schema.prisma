  // balance, not money movement in itself. See lib/actions/refund.ts
  // recordRefundClawback and lib/actions/store.ts recordRefundClawbackSettlement.
  refundClawbackOwed        Decimal     @default(0) @db.Decimal(12, 2)
  refundClawbacks           StoreRefundClawback[]
  refundClawbackSettlements RefundClawbackSettlement[]

