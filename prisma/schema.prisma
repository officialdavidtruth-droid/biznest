model TailoringJob {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobNo       String
  customerName String
  customerPhone String?
  garmentType String
  stage       String   @default("MEASUREMENTS")
  dueDate     DateTime?
  measurements Json?
  fabric       Json?
  notes       String?
  // Money: agreed price and what the customer has paid so far (deposit + later payments). Balance = price - amountPaid.
  price       Decimal? @db.Decimal(12, 2)
  amountPaid  Decimal  @default(0) @db.Decimal(12, 2)
  // Unguessable token for the customer's public status page (/store/<slug>/tailoring/<token>). Never shown to other customers.
  trackingToken String @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-', '')"))
  clientId    String?
  client      TailoringClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Who is making it (free text: a staff member, a freelancer, a team).
  tailorName  String?
  // Reference and progress photos: [{ url, kind: "reference" | "progress", caption?, at }]. Only "progress" shows on the customer's status page.
  photos      Json?
  payments    Payment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([storeId, jobNo])
  @@index([storeId, tailorName])
  @@index([storeId, stage, dueDate])
  @@index([clientId])
}

// A returning customer's saved measurements, keyed by phone number (digits only, country code included), so the
// next job for the same person is pre-filled instead of re-measured.
model TailoringClient {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  phone        String?
  phoneKey     String?
  measurements Json?
  jobs         TailoringJob[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([storeId, phoneKey])
}

// A made-to-measure request a customer sends from the storefront order form (/store/<slug>/order-request).
// The tailor reviews it in the Fashion workspace and either turns it into a TailoringJob or dismisses it.
model TailoringRequest {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerName  String
  customerPhone String
  customerEmail String?
  garmentType   String
  details       String?
  neededBy      DateTime?
  photos        Json?
  // NEW | CONVERTED | DISMISSED
  status        String   @default("NEW")
  jobId         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([storeId, status, createdAt])
}

// ----------------------------------------------------------------------------
// OBSERVABILITY
//
// One row per notable thing that happened somewhere the platform can't just
// let fail silently -- a caught exception, a slow request, a bounced email.
// Deliberately generic (category + level + message + metadata) rather than
// one table per subsystem, since the volume here is "hundreds/day", not
// "millions/day" -- a proper APM (Sentry/Datadog) is the right call past
// this scale, but this gets a self-hosted MVP most of the way there with
// zero new infra. See lib/observability/log.ts for the write path and
// app/supaadmin/system-health for the read path.
// ----------------------------------------------------------------------------
model SystemEvent {
  id         String        @id @default(cuid())
  category   EventCategory
  level      EventLevel
  message    String
  // Freeform context -- stack trace snippet, request path, provider error
  // code, whatever's useful for that category. Never put PII/secrets here.
  metadata   Json?
  // Set only for API-latency events (see withObservability); lets the
  // health page compute p95/avg without a separate metrics table.
  durationMs Int?
  createdAt  DateTime      @default(now())

  @@index([category, createdAt])
  @@index([level, createdAt])
}

enum EventCategory {
  DATABASE
  PAYMENTS
  EMAIL
  MESSAGING
  WEBHOOKS
  STORAGE
  AUTH
  API
  JOBS
}

enum EventLevel {
  INFO
  WARN
  ERROR
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// Generic rate limiter, keyed by e.g. "register:203.0.113.5" or
// "login:someone@example.com". No Redis needed at this scale -- a row per
// key with a rolling window is more than enough for tens of thousands of
// requests/day on Postgres.
model RateLimitEntry {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// ----------------------------------------------------------------------------
// LOYALTY
//
// Cash-out only: points accrue from completed orders at a single global
// rate (read from PlatformSetting, key "LOYALTY_EARN_RATE", shape
// { pointsPerNaira: number }), and a customer redeems them for a Coupon
// scoped to whichever store they're cashing out at (PlatformSetting key
// "LOYALTY_REDEEM_RATE", shape { nairaPerPoint: number }). There is no
// auto-apply-at-checkout path -- redemption always goes through the
// explicit cash-out action.
// ----------------------------------------------------------------------------

model LoyaltyAccount {
  id            String         @id @default(cuid())
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance Int            @default(0)
  entries       LoyaltyEntry[]
  updatedAt     DateTime       @updatedAt
}

model LoyaltyEntry {
  id               String           @id @default(cuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount   @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  // Set for EARN entries (which order generated the points). Null for
  // REDEEM (cash-out) and ADJUSTMENT entries.
  orderId          String?
  order            Order?           @relation(fields: [orderId], references: [id])

  type             LoyaltyEntryType
  // Positive for EARN/ADJUSTMENT-credit, negative for REDEEM.
  points           Int
  note             String?

  createdAt        DateTime         @default(now())

  @@index([loyaltyAccountId])
}

enum LoyaltyEntryType {
  EARN
  REDEEM
  ADJUSTMENT
}

// ----------------------------------------------------------------------------
// GIFT CARDS
//
// Store-scoped stored value. GiftCard.balance is the source of truth and is
// only ever changed together with a GiftCardTransaction row (the ledger), inside
// one DB transaction -- see lib/payments/gift-card-ledger.ts. A CHECK
// constraint in the migration keeps balance >= 0 even if app code is wrong.
// Amounts on transactions are signed: ISSUE/REFUND/ADJUSTMENT-credit are
// positive, REDEEM/ADJUSTMENT-debit are negative.
// ----------------------------------------------------------------------------

enum GiftCardStatus {
  ACTIVE
  DISABLED
}

enum GiftCardTransactionType {
  ISSUE
  REDEEM
  REFUND
  ADJUSTMENT
}

model GiftCard {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code          String
  initialAmount Decimal        @db.Decimal(12, 2)
  balance       Decimal        @db.Decimal(12, 2)
  currency      String         @default("NGN")
  status        GiftCardStatus @default(ACTIVE)
  expiresAt     DateTime?

  recipientName  String?
  recipientEmail String?
  message        String?       @db.Text
  purchaserId    String?
  purchaser      User?         @relation("GiftCardPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  issuedById     String?

  transactions  GiftCardTransaction[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([storeId, code])
  @@index([storeId, status])
  @@index([storeId, recipientEmail])
}

model GiftCardTransaction {
  id           String                  @id @default(cuid())
  giftCardId   String
  giftCard     GiftCard                @relation(fields: [giftCardId], references: [id], onDelete: Cascade)
  type         GiftCardTransactionType
  amount       Decimal                 @db.Decimal(12, 2)
  balanceAfter Decimal                 @db.Decimal(12, 2)
  orderId      String?
  order        Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  note         String?
  createdById  String?
  createdAt    DateTime                @default(now())

  @@index([giftCardId, createdAt])
  @@index([orderId])
}

// ----------------------------------------------------------------------------
// REFERRALS
//
// Each customer can have one code per store. A Referral links a referrer to a
// referred customer (one referrer per customer per store). It moves
// PENDING -> REWARDED when the referred customer's first order is COMPLETED;
// the unique qualifyingOrderId plus a status-guarded update make the reward
// exactly-once even if completion is retried.
// ----------------------------------------------------------------------------

enum ReferralStatus {
  PENDING
  REWARDED
  CANCELLED
  REVERSED // was REWARDED, then the qualifying order was refunded and the points clawed back
}

model ReferralCode {
  id        String     @id @default(cuid())
  storeId   String
  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String
  referrals Referral[]
  createdAt DateTime   @default(now())

  @@unique([storeId, code])
  @@unique([storeId, userId])
}

model Referral {
  id                String         @id @default(cuid())
  storeId           String
  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  codeId            String
  referralCode      ReferralCode   @relation(fields: [codeId], references: [id], onDelete: Cascade)
  referrerId        String
  referrer          User           @relation("ReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId         String
  referee           User           @relation("ReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  status            ReferralStatus @default(PENDING)
  qualifyingOrderId String?        @unique
  qualifyingOrder   Order?         @relation("ReferralQualifyingOrder", fields: [qualifyingOrderId], references: [id], onDelete: SetNull)
  // Points actually paid out (snapshot -- the store may change its rates later).
  referrerPoints    Int            @default(0)
  refereePoints     Int            @default(0)
  rewardedAt        DateTime?
  // Points promised when the code was applied (snapshot of the store's rates
  // at that moment). Payout honours these even if the merchant later lowers
  // the reward. Null on rows created before this field existed.
  promisedReferrerPoints Int?
  promisedRefereePoints  Int?
  // Why a PENDING referral is waiting / why it was cancelled or reversed.
  note              String?
  cancelledAt       DateTime?
  reversedAt        DateTime?
  createdAt         DateTime       @default(now())
  loyaltyEntries    StoreLoyaltyEntry[]

  @@unique([storeId, refereeId])
  @@index([storeId, referrerId])
  @@index([storeId, status])
}

// ----------------------------------------------------------------------------
// INVOICING
//
// Numbered per-store using Store.nextInvoiceNo (incremented transactionally
// on creation). A store's Nth invoice reads e.g. "BN-INV-{N}" -- the display
// prefix is applied in lib/actions/invoice.ts, invoiceNo here just stores
// the rendered string so historical numbers never shift if formatting rules
// change later.
// ----------------------------------------------------------------------------

model Invoice {
  id           String        @id @default(cuid())
  invoiceNo    String

  storeId      String
  store        Store         @relation(fields: [storeId], references: [id])

  // A platform customer, if the invoice was raised against one (e.g.
  // generated from an existing Order or Conversation).
  customerId   String?
  customer     User?         @relation(fields: [customerId], references: [id])
  // Optional link back to an Order this invoice documents.
  orderId      String?       @unique
  order        Order?        @relation(fields: [orderId], references: [id])

  // Free-text fallback so merchants can invoice someone who isn't a
  // registered BizNest customer yet.
  customerName  String?
  customerEmail String?
  customerPhone String?

  items        InvoiceItem[]

  subtotal     Decimal       @db.Decimal(12, 2)
  tax          Decimal       @db.Decimal(12, 2) @default(0)
  discount     Decimal       @db.Decimal(12, 2) @default(0)
  deliveryFee  Decimal       @db.Decimal(12, 2) @default(0)
  total        Decimal       @db.Decimal(12, 2)
  currency     String        @default("NGN")

  status       InvoiceStatus @default(DRAFT)
  paidAt       DateTime?
  // The Payment row that satisfied this invoice, once paid (whether
  // collected in-app via gateway or manually marked paid by the merchant).
  paymentId    String?       @unique
  payment      Payment?      @relation(fields: [paymentId], references: [id])

  pdfUrl       String?
  sentAt       DateTime?
  sentVia      String?       // "email" | "whatsapp" | "both"

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([storeId, invoiceNo])
  @@index([storeId])
  @@index([customerId])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(12, 2)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  CANCELLED
}

// ----------------------------------------------------------------------------
// QUOTATIONS
//
// Numbered per-store using Store.nextQuoteNo, same pattern as invoices.
// Accepting a quote and paying the deposit auto-creates a real Order
// (status PENDING_PAYMENT) linked via Quote.orderId, so dispute/escrow
// machinery is live for the rest of the engagement -- see
// lib/actions/quote.ts:acceptQuoteAndPayDeposit.
// ----------------------------------------------------------------------------

model Quote {
  id            String       @id @default(cuid())
  quoteNo       String

  storeId       String
  store         Store        @relation(fields: [storeId], references: [id])
  customerId    String?
  customer      User?        @relation(fields: [customerId], references: [id])

  customerName  String?
  customerEmail String?
  customerPhone String?

  // Public quote-request details captured from the storefront intake form.
  // These fields keep the original request visible in the merchant Quotes
  // workspace instead of leaving it only in a project/notification.
  serviceType   String?
  brief         String?      @db.Text
  budget        Decimal?     @db.Decimal(12, 2)
  deadline      DateTime?
  referenceFiles Json?

  items         QuoteItem[]

  subtotal      Decimal      @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  currency      String       @default("NGN")

  depositRequired   Decimal?  @db.Decimal(12, 2)
  depositPaymentId  String?   @unique
  depositPayment    Payment?  @relation(fields: [depositPaymentId], references: [id])

  status        QuoteStatus  @default(DRAFT)
  sentAt        DateTime?
  respondedAt   DateTime?
  expiresAt     DateTime?

  // Set once accepted + deposit paid -- see module doc above.
  creativeProject CreativeProject?

  orderId       String?      @unique
  order         Order?       @relation(fields: [orderId], references: [id])

  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([storeId, quoteNo])
  @@index([storeId])
  @@index([customerId])
}

model QuoteItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  description String
  quantity    Int     @default(1)
  unitPrice   Decimal @db.Decimal(12, 2)
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}



enum CreativeProjectStatus {
  NEW
  BRIEFING
  QUOTED
  DESIGN
  AWAITING_APPROVAL
  APPROVED
  IN_PRODUCTION
  QUALITY_CHECK
  READY
  DELIVERED
  COMPLETED
  ON_HOLD
  CANCELLED
}

model CreativeProject {
  id              String                @id @default(cuid())
  projectNo       String                @unique
  publicAccessToken String               @unique @default(cuid())
  storeId         String
  store           Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        User?                 @relation(fields: [customerId], references: [id])
  customerName    String
  customerEmail   String?
  customerPhone   String?
  serviceType     String
  brief           String                @db.Text
  budget          Decimal?              @db.Decimal(12,2)
  deadline        DateTime?
  referenceFiles  Json?
  status          CreativeProjectStatus @default(NEW)
  currentVersion  Int                   @default(0)
  approvalNote    String?               @db.Text
  quoteId         String?               @unique
  quote           Quote?                @relation(fields: [quoteId], references: [id])
  revisions       CreativeProjectRevision[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([storeId, status])
  @@index([customerId])
}

model CreativeProjectRevision {
  id          String          @id @default(cuid())
  projectId   String
  project     CreativeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  version     Int
  previewUrl  String
  note        String?         @db.Text
  status      String          @default("PENDING")
  createdAt   DateTime        @default(now())

  @@unique([projectId, version])
  @@index([projectId])
}

// ----------------------------------------------------------------------------
// PURCHASING
//
// Suppliers a merchant buys stock from, and the purchase orders raised
// against them. A PO moves DRAFT -> SENT -> (PARTIALLY_RECEIVED ->) RECEIVED,
// or CANCELLED from DRAFT/SENT. Receiving a line item is the one write path
// that touches inventory -- it goes through the same adjustStock/
// adjustVariantStock ledger as any other restock, so "Stock history" on a
// product shows PO receipts exactly like a manual restock, just tagged with
// the PO number in its note.
// ----------------------------------------------------------------------------

model Supplier {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name         String
  contactName  String?
  email        String?
  phone        String?
  address      Json?
  notes        String?

  isArchived   Boolean   @default(false)

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([storeId])
}

// Links a Supplier to the products they supply, with the supplier's own SKU
// and last-known cost for that product -- lets the PO form pre-fill lines
// once a merchant picks a supplier + product, without guessing at cost.
model SupplierProduct {
  id           String   @id @default(cuid())
  supplierId   String
  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  supplierSku  String?
  costPrice    Decimal? @db.Decimal(12, 2)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([supplierId, productId])
  @@index([productId])
}

model PurchaseOrder {
  id           String              @id @default(cuid())
  poNumber     String              @unique

  storeId      String
  store        Store               @relation(fields: [storeId], references: [id])
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])

  status       PurchaseOrderStatus @default(DRAFT)
  currency     String              @default("NGN")
  subtotal     Decimal             @db.Decimal(12, 2) @default(0)
  notes        String?
  expectedAt   DateTime?

  sentAt       DateTime?
  receivedAt   DateTime?
  cancelledAt  DateTime?

  items        PurchaseOrderItem[]

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([storeId])
  @@index([supplierId])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  productId        String?
  product          Product?      @relation(fields: [productId], references: [id])
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  // Snapshot of the product/variant name at order time, so a line still
  // reads sensibly even if the product is later renamed or deleted.
  description      String
  quantityOrdered  Int
  quantityReceived Int           @default(0)
  unitCost         Decimal       @db.Decimal(12, 2)
  inventoryBatches InventoryBatch[]

  @@index([purchaseOrderId])
  @@index([productId])
  @@index([variantId])
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum HrEmployeeStatus {
  ACTIVE
  ON_LEAVE
  SUSPENDED
  EXITED
}

enum HrEmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  TEMPORARY
}

enum HrAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
}

enum HrLeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum HrPayrollStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

model HrEmployee {
  id              String             @id @default(cuid())
  storeId         String
  store           Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffId         String?            @unique
  staff            StoreStaff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  employeeNo      String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  department      String?
  position        String?
  employmentType  HrEmploymentType   @default(FULL_TIME)
  status          HrEmployeeStatus   @default(ACTIVE)
  hireDate        DateTime?
  exitDate        DateTime?
  basicSalary     Decimal            @db.Decimal(14,2) @default(0)
  housingAllowance Decimal            @db.Decimal(14,2) @default(0)
  transportAllowance Decimal          @db.Decimal(14,2) @default(0)
  otherAllowance  Decimal            @db.Decimal(14,2) @default(0)
  annualRent      Decimal            @db.Decimal(14,2) @default(0)
  bankName        String?
  accountName     String?
  accountNumber   String?
  notes           String?
  attendance      HrAttendance[]
  leaveRequests   HrLeaveRequest[]
  payrollItems    HrPayrollItem[]
  recruitApplications RecruitApplication[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  @@unique([storeId, employeeNo])
  @@index([storeId, status])
  @@index([storeId, department])
}

model HrAttendance {
  id          String             @id @default(cuid())
  storeId     String
  store       Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    HrEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate    DateTime           @db.Date
  status      HrAttendanceStatus @default(PRESENT)
  checkIn    DateTime?
  checkOut   DateTime?
  note       String?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  @@unique([employeeId, workDate])
  @@index([storeId, workDate])
  @@index([employeeId, workDate])
}

model HrLeaveRequest {
  id          String          @id @default(cuid())
  storeId     String
  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    HrEmployee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType   String
  startDate   DateTime        @db.Date
  endDate     DateTime        @db.Date
  reason      String?
  status      HrLeaveStatus   @default(PENDING)
  decisionNote String?
  decidedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  @@index([storeId, status, startDate])
  @@index([employeeId, startDate, endDate])
}

model HrPayrollRun {
  id            String          @id @default(cuid())
  storeId       String
  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  periodStart   DateTime        @db.Date
  periodEnd     DateTime        @db.Date
  payDate       DateTime?       @db.Date
  status        HrPayrollStatus @default(DRAFT)
  totalGross    Decimal         @db.Decimal(14,2) @default(0)
  totalDeductions Decimal       @db.Decimal(14,2) @default(0)
  totalNet      Decimal         @db.Decimal(14,2) @default(0)
  notes         String?
  items         HrPayrollItem[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  @@index([storeId, periodStart, periodEnd])
  @@index([storeId, status])
}

model HrPayrollItem {
  id              String        @id @default(cuid())
  payrollRunId    String
  payrollRun      HrPayrollRun  @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        HrEmployee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  basic           Decimal       @db.Decimal(14,2) @default(0)
  allowances      Decimal       @db.Decimal(14,2) @default(0)
  deductions      Decimal       @db.Decimal(14,2) @default(0)
  gross           Decimal       @db.Decimal(14,2) @default(0)
  net             Decimal       @db.Decimal(14,2) @default(0)
  note            String?
  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}


// Standalone BizNest Marketing website intelligence. This is additive to the
// existing store CRM/catalog and is only used by the Marketing workspace.
// Security: a website is USABLE (status CONNECTED, catalog populated) only
// after the account proves control of it via a verification token placed on
// the site -- otherwise anyone could point Marketing at a competitor's or a
// stranger's website, pull its branding/catalog, and send fraudulent
// campaigns that look like they come from that business. websiteHost is
// unique platform-wide so the same domain can never be claimed twice.
model MarketingWebsiteConnection {
  id                 String    @id @default(cuid())
  storeId            String    @unique
  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  websiteUrl         String
  websiteHost        String    @unique
  status             String    @default("PENDING_VERIFICATION") // PENDING_VERIFICATION | CONNECTED | FAILED
  verificationToken  String
  verifiedAt         DateTime?
  lastAttemptAt      DateTime?
  emailCode          String?
  emailCodeSentTo    String?
  emailCodeExpiresAt DateTime?
  businessName       String?
  businessType       String?
  logoUrl            String?
  primaryColor       String?
  secondaryColor     String?
  description        String?   @db.Text
  contactEmail       String?
  contactPhone       String?
  socialLinks        Json?
  pages              Json?
  lastScannedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
}

model MarketingCatalogItem {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  externalKey     String
  type            String   @default("PRODUCT")
  name            String
  description     String?  @db.Text
  imageUrl        String?
  url             String?
  price           String?
  salePrice       String?
  currency        String?
  category        String?
  availability    String?
  metadata        Json?
  sourceUrl       String?
  isActive        Boolean  @default(true)
  lastSeenAt      DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([storeId, externalKey])
  @@index([storeId, type])
  @@index([storeId, isActive])
}


// ----------------------------------------------------------------------------
// STOREFRONT NAVIGATION MENU
// Owner-managed header menu (WordPress-style): top-level links with optional
// dropdown children. When a store has no rows here, every template falls back
// to its own default links, so nothing changes until the owner customizes.
// linkType: PAGE (target = path like "/about"), CATEGORY (target = Category.id),
// CUSTOM (target = full URL, "/path", "#anchor", "mailto:" or "tel:").
// ----------------------------------------------------------------------------
model StoreMenuItem {
  id           String          @id @default(cuid())
  storeId      String
  store        Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  location     String          @default("header")
  label        String
  linkType     String          @default("PAGE")
  target       String?
  openInNewTab Boolean         @default(false)
  parentId     String?
  parent       StoreMenuItem?  @relation("StoreMenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     StoreMenuItem[] @relation("StoreMenuTree")
  sortOrder    Int             @default(0)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([storeId, location, sortOrder])
  @@index([parentId])
}

// ----------------------------------------------------------------------------
// CHANNEL SYNC (OTA calendars via iCal) + channel-manager connection requests
// ----------------------------------------------------------------------------

/// One room <-> one OTA listing. Two directions:
///  - export: a secret .ics URL (exportToken) the OTA imports to learn which
///    dates are taken here (direct reservations + blocks from OTHER channels);
///  - import: the OTA's own .ics URL (importUrl) that we poll to learn which
///    dates were sold there, stored as ChannelBlock rows.
model ChannelConnection {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  roomId      String
  room        PropertyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  provider    String   // BOOKING_COM | AIRBNB | EXPEDIA | VRBO | AGODA | TRIPADVISOR | OTHER
  label       String?
  importUrl   String?
  exportToken String   @unique
  isActive    Boolean  @default(true)

  lastSyncAt      DateTime?
  lastSyncStatus  String?   // OK | ERROR
  lastSyncMessage String?
  lastBlockCount  Int       @default(0)

  // Live two-way link (optional, on top of the iCal calendars):
  //  - hookToken: secret path of the inbound webhook (POST /api/channels/hook/<token>);
  //  - liveSecret: HMAC key that signs everything we push and that inbound events must be signed with;
  //  - pushUrl: https endpoint (channel manager, Zapier, Make, own server) we POST availability snapshots to.
  hookToken       String?   @unique
  liveSecret      String?
  pushUrl         String?
  pushSeq         Int       @default(0)
  lastPushAt      DateTime?
  lastPushStatus  String?   // OK | ERROR
  lastPushMessage String?
  lastHookAt      DateTime?

  blocks      ChannelBlock[]
  pushes      ChannelPush[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
  @@index([roomId])
  @@index([isActive, lastSyncAt])
}

/// Outbox of availability snapshots to push to a connection's pushUrl. A new snapshot replaces any
/// still-pending one (latest wins), failed deliveries retry with back-off, then stay FAILED for the owner to retry.
model ChannelPush {
  id            String   @id @default(cuid())
  storeId       String
  connectionId  String
  connection    ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  seq           Int
  payload       String   @db.Text
  status        String   @default("PENDING") // PENDING | SENT | FAILED
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?
  createdAt     DateTime @default(now())
  sentAt        DateTime?

  @@index([status, nextAttemptAt])
  @@index([connectionId, status])
  @@index([storeId])
}

/// A date range an OTA reports as sold/unavailable for a room.
/// startDate inclusive, endDate exclusive (iCal all-day DTEND semantics).
model ChannelBlock {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  roomId       String
  room         PropertyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  connectionId String
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  uid          String
  startDate    DateTime
  endDate      DateTime
  summary      String?
  createdAt    DateTime @default(now())

  @@unique([connectionId, uid])
  @@index([roomId, startDate, endDate])
  @@index([storeId])
}

/// A hotel asking BizNest to connect it to a certified channel manager
/// (e.g. RateTiger). These need a partner certification and credentials on the
/// provider's side, so this records the request and its status for staff.
model ChannelManagerRequest {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  provider     String   // RATETIGER | OTHER
  propertyCode String?
  contactEmail String
  notes        String?
  status       String   @default("REQUESTED") // REQUESTED | IN_PROGRESS | CONNECTED | DECLINED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([storeId])
  @@index([status])
}

// ----------------------------------------------------------------------------
// BROWSE (public social feed at /browse): vendors post updates and products,
// visitors like and comment, a tap goes to the vendor's storefront.
// ----------------------------------------------------------------------------

model BrowsePost {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind            String   @default("UPDATE") // UPDATE | PRODUCT
  caption         String   @db.Text
  images          String[]
  // Public Cloudinary video (compressed at upload). images[0] is its poster frame.
  videoUrl        String?
  // Emoji stickers placed on the cover: [{ e, x, y, s }] (x/y are percentages, s is a size multiplier).
  stickers        Json?
  // What productId points at: PRODUCT or SERVICE.
  tagKind         String   @default("PRODUCT")
  location        String?
  aiGenerated     Boolean  @default(false)
  // Snapshot of the shared product (no FK: the post stays readable if the product is later deleted or edited).
  productId       String?
  productName     String?
  productPrice    Decimal? @db.Decimal(12, 2)
  productCurrency String?
  status          String   @default("PUBLISHED") // PUBLISHED | HIDDEN | REMOVED
  hiddenReason    String?  // OWNER | REPORTS | ADMIN
  likeCount       Int      @default(0)
  commentCount    Int      @default(0)
  saveCount       Int      @default(0)
  // Taps on the "Shop now / Book now" bar. Counted for ranking and the seller's Insights.
  shopTapCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  saves    BrowseSave[]
  likes    BrowseLike[]
  comments BrowseComment[]
  reports  BrowseReport[]
  tags     BrowsePostTag[]

  @@index([status, createdAt])
  @@index([status, likeCount])
  @@index([storeId, createdAt])
}

/// A business or one of the posting store's own customers tagged in a post. Exactly one of tagStoreId / tagUserId is set.
model BrowsePostTag {
  id         String     @id @default(cuid())
  postId     String
  post       BrowsePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tagStoreId String?
  tagStore   Store?     @relation("BrowseTaggedStore", fields: [tagStoreId], references: [id], onDelete: Cascade)
  tagUserId  String?
  tagUser    User?      @relation("BrowseTaggedUser", fields: [tagUserId], references: [id], onDelete: Cascade)
  createdAt  DateTime   @default(now())

  @@unique([postId, tagStoreId])
  @@unique([postId, tagUserId])
  @@index([tagStoreId])
  @@index([tagUserId])
}

/// viewerKey: "u:<userId>" for a signed-in BizNest account, otherwise "d:<random device id>".
model BrowseLike {
  id        String     @id @default(cuid())
  postId    String
  post      BrowsePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewerKey String
  createdAt DateTime   @default(now())

  @@unique([postId, viewerKey])
  @@index([viewerKey])
}

/// A post saved to the viewer's own "Saved" list. viewerKey as in BrowseLike (needs a BizNest account to create).
model BrowseSave {
  id        String     @id @default(cuid())
  postId    String
  post      BrowsePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewerKey String
  createdAt DateTime   @default(now())

  @@unique([postId, viewerKey])
  @@index([viewerKey, createdAt])
}

model BrowseComment {
  id         String     @id @default(cuid())
  postId     String
  post       BrowsePost @relation(fields: [postId], references: [id], onDelete: Cascade)
  viewerKey  String
  authorName String
  body       String     @db.Text
  status     String     @default("VISIBLE") // VISIBLE | HIDDEN
  // Written by the store that owns the post (shows a "Store" mark), and pinned to the top by that store.
  byStore    Boolean    @default(false)
  pinned     Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([postId, status, createdAt])
  @@index([viewerKey])
}

model BrowseReport {
  id        String      @id @default(cuid())
  postId    String?
  post      BrowsePost? @relation(fields: [postId], references: [id], onDelete: Cascade)
  storyId   String?
  story     BrowseStory? @relation(fields: [storyId], references: [id], onDelete: Cascade)
  commentId String?
  /// "post:<id>", "comment:<id>" or "story:<id>": one report per viewer per target.
  targetKey String
  viewerKey String
  reason    String     // SPAM | SCAM | OFFENSIVE | ILLEGAL | OTHER
  status    String     @default("OPEN") // OPEN | UPHELD | DISMISSED
  createdAt DateTime   @default(now())

  @@unique([targetKey, viewerKey])
  @@index([status, createdAt])
  @@index([postId])
  @@index([storyId])
}

/// A 24-hour story: one photo or a text card, optionally pointing at a product. Shown as a ring above the feed.
model BrowseStory {
  id              String   @id @default(cuid())
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind            String   @default("IMAGE") // IMAGE | TEXT
  imageUrl        String?
  text            String?
  bgColor         String?
  productId       String?
  productName     String?
  productPrice    Decimal? @db.Decimal(12, 2)
  productCurrency String?
  status          String   @default("ACTIVE") // ACTIVE | REMOVED
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  views   BrowseStoryView[]
  reports BrowseReport[]

  @@index([status, expiresAt])
  @@index([storeId, createdAt])
}

model BrowseStoryView {
  id        String      @id @default(cuid())
  storyId   String
  story     BrowseStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewerKey String
  createdAt DateTime    @default(now())

  @@unique([storyId, viewerKey])
  @@index([viewerKey, createdAt])
}

// ----------------------------------------------------------------------------
// SUPPORT REQUESTS (merchant -> BizNest team, from the dashboard help chat)
// ----------------------------------------------------------------------------

model SupportRequest {
  id         String   @id @default(cuid())
  // Plain ids (no relations) so a deleted store/user never blocks or erases the record.
  storeId    String?
  storeSlug  String?
  storeName  String?
  userId     String
  userEmail  String?
  userName   String?
  message    String   @db.Text
  transcript String   @db.Text
  status     String   @default("OPEN") // OPEN | RESOLVED
  emailSent  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([status, createdAt])
  @@index([storeId])
  @@index([userId, createdAt])
}

// ----------------------------------------------------------------------------
// BIZNEST TRAVEL (travel agency workspace: /store/[slug]/admin/travel)
// All rows are store-scoped. Status fields are plain strings validated in lib/travel.ts.
// ----------------------------------------------------------------------------

model TravelClient {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  fullName    String
  email       String?
  phone       String?
  nationality String?
  passportNo  String?
  passportExpiry DateTime?
  dateOfBirth DateTime?
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       TravelTrip[]
  visaCases   TravelVisaCase[]

  @@index([storeId, fullName])
  @@index([storeId, phone])
}

model TravelSupplier {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  kind        String   @default("OTHER") // AIRLINE | HOTEL | TOUR_OPERATOR | TRANSPORT | INSURER | CONSOLIDATOR | OTHER
  contactName String?
  email       String?
  phone       String?
  notes       String?  @db.Text
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  items       TravelTripItem[]
  payments    TravelSupplierPayment[]

  @@index([storeId, isArchived])
}

// Money the agency has paid a supplier (airline, hotel, operator). What is owed comes from the cost price of the
// supplier's non-cancelled service lines on non-cancelled trips; see supplierBalances() in lib/travel.ts.
model TravelSupplierPayment {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    TravelSupplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN")
  method      String   @default("TRANSFER") // CASH | TRANSFER | CARD | POS | OTHER
  status      String   @default("RECORDED") // RECORDED | VOID
  paidAt      DateTime @default(now())
  reference   String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([storeId, supplierId, status])
}

model TravelAgent {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  phone       String?
  defaultRate Decimal  @default(0) @db.Decimal(5, 2) // percent, copied onto a trip when the agent is assigned
  defaultBasis String  @default("SELL")
  isArchived  Boolean  @default(false)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  trips       TravelTrip[]
  payments    TravelAgentPayment[]

  @@index([storeId, isArchived])
}

// Commission paid out to an agent. What is owed comes from commissionFor() over the agent's confirmed trips.
model TravelAgentPayment {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  agentId     String
  agent       TravelAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  currency    String   @default("NGN")
  method      String   @default("TRANSFER")
  status      String   @default("RECORDED") // RECORDED | VOID
  paidAt      DateTime @default(now())
  reference   String?
  note        String?
  createdAt   DateTime @default(now())

  @@index([storeId, agentId, status])
}

model TravelPackage {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  destination String
  durationDays Int     @default(1)
  pricePerPerson Decimal @db.Decimal(12, 2)
  currency    String   @default("NGN")
  departureDate DateTime?
  seats       Int      @default(0) // 0 = unlimited
  depositPercent Int    @default(30) // share of the total paid online to book (100 = full payment, 0 = enquiry only)
  inclusions  String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       TravelTrip[]
  departures  TravelDeparture[]

  @@index([storeId, isActive])
}

model TravelDeparture {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  packageId   String
  package     TravelPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  departureDate DateTime
  seats       Int      @default(0) // 0 = use the package's seat count
  cutoffDays  Int      @default(0) // online booking closes this many days before departure
  pricePerPerson Decimal? @db.Decimal(12, 2) // null = package price
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  trips       TravelTrip[]

  @@index([packageId, departureDate])
  @@index([storeId, departureDate])
}

model TravelSettings {
  storeId     String   @id
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  termsText   String?  @db.Text // default booking terms copied onto each proposal
  remindersEnabled Boolean @default(true) // email travellers about instalments that are due or overdue
  reviewUrl   String?  // where the post-trip email sends people to leave a review
  partnerKeyHash String? // SHA-256 of the partner API key; the key itself is shown once
  partnerKeyHint String? // last 4 characters, so the owner can tell which key is active
  updatedAt   DateTime @updatedAt
}

model TravelTrip {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reference   String
  clientId    String
  client      TravelClient @relation(fields: [clientId], references: [id], onDelete: Restrict)
  packageId   String?
  package     TravelPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title       String
  destination String
  status      String   @default("ENQUIRY") // ENQUIRY | QUOTED | CONFIRMED | TICKETED | TRAVELLING | COMPLETED | CANCELLED
  departDate  DateTime?
  returnDate  DateTime?
  currency    String   @default("NGN")
  totalPrice  Decimal  @default(0) @db.Decimal(12, 2)
  totalCost   Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?  @db.Text
  // Sub-agent / referrer who brought the booking. Rate and basis are copied from the agent when assigned and can be overridden per trip.
  agentId     String?
  agent       TravelAgent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  commissionRate  Decimal  @default(0) @db.Decimal(5, 2) // percent
  commissionBasis String   @default("SELL") // SELL (share of the selling price) | MARGIN (share of price minus cost)
  departureId String?
  departure   TravelDeparture? @relation(fields: [departureId], references: [id], onDelete: SetNull)
  shareToken  String?  @unique // unguessable token for the public proposal / My Trip page
  proposalNote String? @db.Text
  proposalValidUntil DateTime?
  proposalSentAt DateTime?
  termsText   String?  @db.Text // terms as they were when the proposal was shared
  acceptedAt  DateTime?
  acceptedName String?
  acceptedIp  String?
  reviewRequestedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  travellers  TravelTraveler[]
  items       TravelTripItem[]
  payments    TravelPayment[]
  gatewayPayments Payment[]
  itineraryDays TravelItineraryDay[]
  attachments TravelAttachment[]

  @@unique([storeId, reference])
  @@index([storeId, status])
  @@index([storeId, departDate])
  @@index([clientId])
  @@index([agentId])
  @@index([departureId])
}

model TravelTraveler {
  id          String   @id @default(cuid())
  tripId      String
  trip        TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fullName    String
  passportNo  String?
  passportExpiry DateTime?
  dateOfBirth DateTime?
  nationality String?
  isLead      Boolean  @default(false)
  // Group-departure fields (manifest + rooming list). See lib/travel.ts roomingGroups().
  gender      String?  // M | F
  roomType    String?  // SINGLE | DOUBLE | TWIN | TRIPLE | QUAD
  roomLabel   String?  // room number or group name; travellers sharing a label share a room
  requests    String?  // dietary, mobility, special requests

  @@index([tripId])
}

model TravelTripItem {
  id          String   @id @default(cuid())
  tripId      String
  trip        TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  supplierId  String?
  supplier    TravelSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  kind        String   @default("OTHER") // FLIGHT | HOTEL | TRANSFER | TOUR | VISA | INSURANCE | OTHER
  description String
  startDate   DateTime?
  endDate     DateTime?
  confirmationRef String?
  status      String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  costPrice   Decimal  @default(0) @db.Decimal(12, 2) // always in the trip's currency
  costCurrency String? // set when the supplier charges in another currency
  costAmount  Decimal? @db.Decimal(14, 2) // the supplier's price in costCurrency
  fxRate      Decimal? @db.Decimal(16, 6) // trip currency per 1 unit of costCurrency, as entered
  sellPrice   Decimal  @default(0) @db.Decimal(12, 2)
  flightDetails Json? // FLIGHT lines only: see lib/travel-flight.ts
  ticketingDeadline DateTime? // the airline's time limit to issue tickets
  ticketingAlertedAt DateTime? // set once the agency has been alerted about the deadline
  createdAt   DateTime @default(now())

  @@index([tripId])
  @@index([supplierId])
  @@index([ticketingDeadline])
}

model TravelPayment {
  id          String   @id @default(cuid())
  tripId      String
  trip        TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  method      String   @default("TRANSFER") // CASH | TRANSFER | CARD | POS | OTHER
  status      String   @default("RECEIVED") // DUE | RECEIVED | VOID | REFUNDED (fully refunded)
  dueDate     DateTime?
  paidAt      DateTime?
  reference   String?
  note        String?
  // One refund per payment. Partial refunds keep status RECEIVED (the agency retains the rest, e.g. a cancellation fee);
  // a full refund moves it to REFUNDED. See lib/payments/refund-travel.ts.
  refundedAmount  Decimal  @default(0) @db.Decimal(12, 2)
  refundedAt      DateTime?
  refundReference String?
  refundReason    String?
  refundedByEmail String?
  reminderCount   Int      @default(0)
  lastReminderAt  DateTime?
  createdAt   DateTime @default(now())

  @@unique([tripId, reference])
  @@index([tripId, status])
}

// Hand-written day-by-day programme shown on the client itinerary PDF (dated service lines are merged in by date).
model TravelItineraryDay {
  id          String   @id @default(cuid())
  tripId      String
  trip        TravelTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  dayNumber   Int
  title       String
  description String?  @db.Text
  createdAt   DateTime @default(now())

  @@unique([tripId, dayNumber])
  @@index([tripId])
}

model TravelVisaCase {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  clientId    String
  client      TravelClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  country     String
  visaType    String   @default("TOURIST")
  status      String   @default("DOCUMENTS") // DOCUMENTS | SUBMITTED | APPOINTMENT | DECISION_PENDING | APPROVED | REFUSED
  checklist   Json?    // [{ label: string, done: boolean }]
  appointmentAt DateTime?
  submittedAt DateTime?
  fee         Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  attachments TravelAttachment[]

  @@index([storeId, status])
  @@index([clientId])
}

// A private file (passport scan, ticket, visa approval...) on a trip or a visa case. The bytes live in Cloudinary as
// "authenticated" assets and are only readable through /api/store/[slug]/travel/attachments/[id] (staff permission checked).
model TravelAttachment {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tripId      String?
  trip        TravelTrip? @relation(fields: [tripId], references: [id], onDelete: Cascade)
  visaCaseId  String?
  visaCase    TravelVisaCase? @relation(fields: [visaCaseId], references: [id], onDelete: Cascade)
  travelerId  String?  // optional: which traveller on the trip a passport scan belongs to
  kind        String   @default("OTHER") // PASSPORT | TICKET | VISA | INSURANCE | VOUCHER | OTHER
  fileName    String
  mimeType    String
  sizeBytes   Int
  publicId    String   // Cloudinary public_id (raw, authenticated)
  note        String?
  uploadedByEmail String?
  createdAt   DateTime @default(now())

  @@index([storeId, tripId])
  @@index([storeId, visaCaseId])
}


// ----------------------------------------------------------------------------
// BLOG (BizNest Blog app), modelled on Shopify: a store has one or more BLOGS (e.g. "News"), each holding
// ARTICLES. There is no category tree; articles are organised by blog and by tags. Visibility is
// publishedAt: null = hidden, a past/now date = visible, a future date = scheduled.
// ----------------------------------------------------------------------------

model Blog {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  handle    String   // URL segment: /blogs/<handle>. Stays the same when the title is renamed unless edited.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@unique([storeId, handle])
  @@index([storeId, createdAt])
}

model Article {
  id      String @id @default(cuid())
  storeId String
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  blogId  String
  blog    Blog   @relation(fields: [blogId], references: [id], onDelete: Cascade)

  title   String
  handle  String   // unique within its blog
  excerpt String?
  body    String   @db.Text // Markdown. Rendered to React nodes (never raw HTML) on the storefront.
  tags    String[] @default([])

  imageUrl String?
  imageAlt String?

  authorId   String?
  authorName String

  // null = Hidden. <= now = Visible. > now = Scheduled (goes live by itself, no cron needed).
  publishedAt DateTime?

  seoTitle       String?
  seoDescription String?

  readingMinutes Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([blogId, handle])
  @@index([storeId, publishedAt])
  @@index([blogId, publishedAt])
}


// ── Applicant tracking (Recruitment plugin) ───────────────────────────────
enum RecruitJobStatus {
  DRAFT
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum RecruitStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
  WITHDRAWN
}

model RecruitJob {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  clientName     String?
  department     String?
  location       String?
  employmentType String           @default("FULL_TIME")
  salaryMin      Decimal?         @db.Decimal(14,2)
  salaryMax      Decimal?         @db.Decimal(14,2)
  openings       Int              @default(1)
  description    String?
  requirements   String?
  status         RecruitJobStatus @default(OPEN)
  closesAt       DateTime?        @db.Date
  showSalary     Boolean          @default(false)
  applications   RecruitApplication[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

model RecruitCandidate {
  id             String     @id @default(cuid())
  storeId        String
  store          Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  firstName      String
  lastName       String
  email          String?
  phone          String?
  currentRole    String?
  currentCompany String?
  location       String?
  skills         String?
  source         String?
  cvUrl          String?
  notes          String?
  applications   RecruitApplication[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  @@unique([storeId, email])
  @@index([storeId, lastName])
}

model RecruitApplication {
  id             String           @id @default(cuid())
  storeId        String
  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobId          String
  job            RecruitJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      RecruitCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stage          RecruitStage     @default(APPLIED)
  rating         Int?
  interviewAt    DateTime?
  offerAmount    Decimal?         @db.Decimal(14,2)
  rejectionReason String?
  notes          String?
  hrEmployeeId   String?
  hrEmployee     HrEmployee?      @relation(fields: [hrEmployeeId], references: [id], onDelete: SetNull)
  stageChangedAt DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  @@unique([jobId, candidateId])
  @@index([hrEmployeeId])
  @@index([storeId, stage])
  @@index([candidateId])
}

/// One amount a tenant owes for a unit (a rent period, a service charge, a caution fee).
model RentCharge {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  unitId    String
  unit      RealEstateUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("DUE") // DUE | PAID | VOID
  dueDate   DateTime
  paidAt    DateTime?
  method    String?  // CASH | TRANSFER | CARD | POS | OTHER
  reference String?
  receiptNo String?
  note      String?
  reminderCount  Int @default(0)
  lastReminderAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  payments  Payment[]
  @@unique([storeId, receiptNo])
  @@index([storeId, status, dueDate])
  @@index([unitId, status])
}

model MaintenanceRequest {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  unitId     String
  unit       RealEstateUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title      String
  detail     String?
  priority   String   @default("NORMAL") // LOW | NORMAL | URGENT
  status     String   @default("OPEN")   // OPEN | IN_PROGRESS | DONE | CANCELLED
  reportedBy String?  // TENANT | STAFF
  vendor     String?
  cost       Decimal? @db.Decimal(12, 2)
  resolvedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([storeId, status])
  @@index([unitId])
}


// ---- Members and billing: church members and giving, salon clients and packages, gym memberships ----

model Member {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  phone       String?
  email       String?
  notes       String?
  portalToken String?  @unique
  active      Boolean  @default(true)
  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  memberships Membership[]
  charges     MemberCharge[]
  checkIns    MemberCheckIn[]
  @@index([storeId, active])
  @@index([storeId, name])
}

model MemberPlan {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name         String
  kind         String   @default("MEMBERSHIP") // MEMBERSHIP | PACKAGE | FUND (a giving fund such as Tithe)
  price        Decimal  @default(0) @db.Decimal(12, 2)
  interval     String   @default("MONTHLY") // WEEKLY | MONTHLY | QUARTERLY | ANNUAL | ONCE
  sessions     Int?     // sessions in a package or class pack
  validityDays Int?     // a package expires this many days after it starts
  description  String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  memberships  Membership[]
  @@index([storeId, kind, active])
}

model Membership {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  planId       String
  plan         MemberPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  status       String   @default("ACTIVE") // ACTIVE | PAUSED | CANCELLED
  startsAt     DateTime @default(now())
  renewsAt     DateTime?
  endsAt       DateTime?
  sessionsLeft Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  charges      MemberCharge[]
  checkIns     MemberCheckIn[]
  @@index([storeId, status, renewsAt])
  @@index([memberId])
}

model MemberCharge {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  memberId       String?  // empty for a gift from someone who is not on the member list
  member         Member?  @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipId   String?
  membership     Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  kind           String   @default("DUES") // DUES | PACKAGE | GIVING | OTHER
  fund           String?  // the giving fund, for GIVING
  label          String
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @default("DUE") // DUE | PAID | VOID
  dueDate        DateTime
  paidAt         DateTime?
  method         String?  // CASH | TRANSFER | CARD | POS | OTHER
  reference      String?
  receiptNo      String?
  note           String?
  donorName      String?
  donorEmail     String?
  reminderCount  Int      @default(0)
  lastReminderAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  payments       Payment[]
  @@unique([storeId, receiptNo])
  @@index([storeId, status, dueDate])
  @@index([storeId, kind, status, paidAt])
  @@index([memberId, status])
  @@index([membershipId])
}

model MemberCheckIn {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  memberId     String
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  membershipId String?
  membership   Membership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  at           DateTime @default(now())
  note         String?
  usedSession  Boolean  @default(false)
  @@index([storeId, at])
  @@index([memberId, at])
}

// ---- Event ticketing: tiers, QR tickets, gate check-in, guest lists ----

model TicketEvent {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String?
  venue       String?
  imageUrl    String?
  startsAt    DateTime
  endsAt      DateTime?
  status      String   @default("DRAFT") // DRAFT | PUBLISHED | CLOSED | CANCELLED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tiers       TicketTier[]
  orders      TicketOrder[]
  tickets     Ticket[]
  @@unique([storeId, slug])
  @@index([storeId, status, startsAt])
}

model TicketTier {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  eventId     String
  event       TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal  @db.Decimal(12, 2) @default(0)
  capacity    Int
  sold        Int      @default(0) // paid plus currently held by unpaid orders
  maxPerOrder Int      @default(10)
  saleEndsAt  DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  items       TicketOrderItem[]
  tickets     Ticket[]
  @@index([eventId, active])
}

model TicketOrder {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  eventId     String
  event       TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  buyerName   String
  buyerEmail  String?
  buyerPhone  String?
  total       Decimal  @db.Decimal(12, 2)
  status      String   @default("PENDING") // PENDING | PAID | CANCELLED
  accessToken String   @unique // opens the buyer's tickets page
  method      String?
  reference   String?
  receiptNo   String?
  note        String?
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  items       TicketOrderItem[]
  tickets     Ticket[]
  payments    Payment[]
  @@unique([storeId, receiptNo])
  @@index([storeId, status, createdAt])
  @@index([eventId, status])
}

model TicketOrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tierId    String
  tier      TicketTier  @relation(fields: [tierId], references: [id], onDelete: Restrict)
  qty       Int
  unitPrice Decimal  @db.Decimal(12, 2)
  @@index([orderId])
}

model Ticket {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  eventId      String
  event        TicketEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tierId       String
  tier         TicketTier  @relation(fields: [tierId], references: [id], onDelete: Restrict)
  orderId      String
  order        TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code         String   @unique // what the QR code carries; unguessable
  holderName   String?
  status       String   @default("VALID") // VALID | CHECKED_IN | VOID
  checkedInAt  DateTime?
  createdAt    DateTime @default(now())
  @@index([eventId, status])
  @@index([orderId])
}

// ---- Logistics dispatch: riders, delivery jobs, tracking, proof of delivery, cash-on-delivery remittance ----

model Rider {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  vehicle    String?
  active     Boolean  @default(true)
  accessToken String  @unique // the rider's own link; no sign-in
  createdAt  DateTime @default(now())
  deliveries Delivery[]
  @@index([storeId, active])
}

model Delivery {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobNo         String   // DLV-00001, per store
  riderId       String?
  rider         Rider?   @relation(fields: [riderId], references: [id], onDelete: SetNull)
  customerName  String
  customerPhone String?
  customerEmail String?
  pickupAddress String
  pickupContact String?
  dropoffAddress String
  dropoffContact String?
  itemDescription String?
  fee           Decimal  @db.Decimal(12, 2) @default(0)
  feePaid       Boolean  @default(false)
  codAmount     Decimal  @db.Decimal(12, 2) @default(0) // cash the rider collects for the sender
  codRemittedAt DateTime? // when the rider handed the cash in
  status        String   @default("NEW") // NEW | ASSIGNED | PICKED_UP | DELIVERED | FAILED | CANCELLED
  trackToken    String   @unique // the customer's tracking link
  deliveryPin   String   // 4 digits the customer gives the rider at the door
  recipientName String?
  failureReason String?
  assignedAt    DateTime?
  pickedUpAt    DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  events        DeliveryEvent[]
  @@unique([storeId, jobNo])
  @@index([storeId, status, createdAt])
  @@index([riderId, status])
}

model DeliveryEvent {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  status     String
  note       String?
  at         DateTime @default(now())
  @@index([deliveryId, at])
}

// ---- Job cards: auto workshop, cleaning, construction, photography ----

model JobCard {
  id             String   @id @default(cuid())
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobNo          String   // JOB-00001, per store
  niche          String   // AUTO | CLEANING | CONSTRUCTION | PHOTOGRAPHY
  title          String
  customerName   String
  customerPhone  String?
  customerEmail  String?
  subject        String?  // vehicle registration, site address or shoot location
  subjectDetail  String?  // make and model, scope, or shoot type
  stage          String   // one of the niche's stages
  status         String   @default("OPEN") // OPEN | DONE | CANCELLED
  scheduledFor   DateTime?
  completedAt    DateTime?
  estimateStatus String   @default("NONE") // NONE | PENDING | APPROVED | DECLINED
  estimateRespondedAt DateTime?
  deliverableUrl String?  // final gallery, report or handover pack; shown once nothing is owing
  internalNotes  String?
  accessToken    String   @unique // the customer's link
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          JobCardItem[]
  charges        JobCharge[]
  updates        JobUpdate[]
  @@unique([storeId, jobNo])
  @@index([storeId, status, createdAt])
}

model JobCardItem {
  id        String   @id @default(cuid())
  jobId     String
  job       JobCard  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind      String   @default("LABOUR") // LABOUR | PARTS | MATERIALS | FEE | OTHER
  label     String
  qty       Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
  @@index([jobId])
}

model JobCharge {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  jobId     String
  job       JobCard  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  label     String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("DUE") // DUE | PAID | VOID
  paidAt    DateTime?
  method    String?
  reference String?
  receiptNo String?
  createdAt DateTime @default(now())
  payments  Payment[]
  @@unique([storeId, receiptNo])
  @@index([jobId, status])
}

model JobUpdate {
  id        String   @id @default(cuid())
  jobId     String
  job       JobCard  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  message   String
  imageUrl  String?
  stage     String?
  at        DateTime @default(now())
  @@index([jobId, at])
}


/// A paid promotion on Browse. placement FEED = a sponsored post between feed posts;
/// STORY = a sponsored ring in the story row. The creative is its own snapshot (not a live post).
/// Billing is prepaid per 1,000 impressions: the campaign ends when `impressionsBought` is used up or `endsAt` passes.
model AdCampaign {
  id                String    @id @default(cuid())
  storeId           String
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  placement         String    // FEED | STORY
  caption           String?   @db.Text
  imageUrl          String?
  bgColor           String?   // text-only STORY creatives
  ctaLabel          String    @default("SHOP_NOW")
  productId         String?
  productName       String?
  productPrice      Decimal?  @db.Decimal(12, 2)
  productCurrency   String?
  budget            Decimal   @db.Decimal(12, 2)
  rateNaira         Decimal   @db.Decimal(12, 2) // price per 1,000 impressions, frozen at purchase
  impressionsBought Int
  durationDays      Int
  status            String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | ACTIVE | PAUSED | COMPLETED | REMOVED
  pausedBy          String?   // OWNER | ADMIN | REPORTS
  paymentReference  String?   @unique
  startsAt          DateTime?
  endsAt            DateTime?
  impressions       Int       @default(0)
  clicks            Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  views   AdViewer[]
  reports AdReport[]

  @@index([status, placement, endsAt])
  @@index([storeId, createdAt])
}

/// Frequency cap: how many times one viewer has seen one campaign in the current 24h window.
model AdViewer {
  id          String     @id @default(cuid())
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewerKey   String
  seen        Int        @default(0)
  windowStart DateTime   @default(now())

  @@unique([campaignId, viewerKey])
}

model AdReport {
  id         String     @id @default(cuid())
  campaignId String
  campaign   AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  viewerKey  String
  reason     String
  createdAt  DateTime   @default(now())

  @@unique([campaignId, viewerKey])
  @@index([campaignId])
}


/// Someone following a business on Browse. viewerKey: "u:<userId>" for a signed-in account, otherwise "d:<device id>".
/// Store.followerCount is the running total so the feed never has to count rows.
/// Daily Browse counters for a store: PROFILE_VIEW, POST_IMPRESSION and SHARE. postId is "" for store-level rows.
model BrowseStat {
  id      String   @id @default(cuid())
  storeId String
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  day     DateTime @db.Date
  kind    String
  postId  String   @default("")
  count   Int      @default(0)

  @@unique([storeId, day, kind, postId])
  @@index([storeId, day])
}

model BrowseFollow {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  viewerKey String
  createdAt DateTime @default(now())

  @@unique([storeId, viewerKey])
  @@index([viewerKey, createdAt])
}

// Daily page-view counts for BizNest itself (seller dashboard, storefronts, platform pages), shown to the
// super admin under "Page usage". One row per day and page name, never per visit, so it stays tiny and a
// view costs a single upsert. Page names are grouped (see lib/page-usage.ts): "/[store]/admin/orders".
model PlatformPageStat {
  id            String   @id @default(cuid())
  day           DateTime @db.Date
  path          String
  area          String
  views         Int      @default(0)
  signedInViews Int      @default(0)

  @@unique([day, path])
  @@index([day])
}


// --- BizNest's own emails to its users (signup reminders, curated/promo campaigns) ---
// One row per email sent. The unique key makes every send idempotent: a
// reminder stage or a campaign can only ever reach a given user once.
model PlatformEmailLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "REMINDER_1" | "REMINDER_2" | "REMINDER_3" | "CAMPAIGN:<campaignId>"
  kind      String
  createdAt DateTime @default(now())

  @@unique([userId, kind])
  @@index([kind])
}

model PlatformCampaign {
  id         String    @id @default(cuid())
  subject    String
  body       String    @db.Text
  ctaLabel   String?
  ctaUrl     String?
  // NO_BUSINESS | BUSINESS_NO_STORE | STORE_OWNERS | ALL
  audience   String
  // DRAFT | SENDING | SENT
  status     String    @default("DRAFT")
  sentCount  Int       @default(0)
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  @@index([status])
}


// --- BizNest vendor referral program ---------------------------------------
// A vendor shares their code; when a person they referred pays for a plan, the
// reward is held for a refund window, then counts toward the vendor's wallet.
// The wallet is derived from these rows (no separate balance to drift).
model VendorReferralCode {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   @unique
  createdAt DateTime @default(now())
}

model VendorReferral {
  id           String   @id @default(cuid())
  referrerId   String
  referrer     User     @relation("VendorReferralReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  // One referrer per person, fixed at signup.
  refereeId    String   @unique
  referee      User     @relation("VendorReferralReferee", fields: [refereeId], references: [id], onDelete: Cascade)
  codeId       String
  // SIGNED_UP (trial, no payment yet) | PENDING (paid, in refund window) | CONFIRMED | CANCELLED
  status       String   @default("SIGNED_UP")
  planId       String?
  planName     String?
  planPrice    Decimal? @db.Decimal(12, 2)
  // Snapshots taken when the plan is paid, so later rate changes never touch earned rewards.
  reward       Decimal  @default(0) @db.Decimal(12, 2)
  unlockCount  Int      @default(0)
  paymentReference String? @unique
  paidAt       DateTime?
  confirmAt    DateTime?
  confirmedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  // Suspicious signals for the admin (e.g. "same_ip", "same_phone"); never block by themselves.
  flags        String[] @default([])
  signupIpHash String?
  // Set when a withdrawal has taken this reward; null = still in the wallet.
  withdrawalId String?
  withdrawal   VendorReferralWithdrawal? @relation(fields: [withdrawalId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([referrerId, status])
  @@index([status, confirmAt])
  @@index([withdrawalId])
}

model VendorReferralWithdrawal {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Rewards withdrawn (gross). The vendor is sent amount - feeAmount; the transfer fee comes out of their reward.
  amount            Decimal  @db.Decimal(12, 2)
  feeAmount         Decimal  @default(0) @db.Decimal(12, 2)
  // FLUTTERWAVE | KORAPAY: fixed when the withdrawal is created so retries never switch gateway.
  gateway           String   @default("FLUTTERWAVE")
  // REVIEW (large, waiting for admin) | QUEUED | PROCESSING | PAID | FAILED | CANCELLED
  status            String   @default("QUEUED")
  reference         String   @unique
  bankCode          String
  accountNumber     String
  accountName       String?
  bankName          String?
  gatewayTransferId String?
  lastError         String?
  attempts          Int      @default(0)
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  referrals         VendorReferral[]

  @@index([status])
  @@index([userId, createdAt])
}

/// What a viewer (signed-in account or this device) tends to watch, like and search. Powers the "For you" feed.
/// kind is STORE, CATEGORY or TAG; key is the store id, category name or hashtag. weight decays with a 2-week half-life.
model BrowseInterest {
  id        String   @id @default(cuid())
  viewerKey String
  kind      String
  key       String
  weight    Float
  updatedAt DateTime @default(now())

  @@unique([viewerKey, kind, key])
  @@index([viewerKey, weight])
  @@index([updatedAt])
}


// A door reader/controller (ESP32, relay board, or a lock vendor's gateway) that asks BizNest
// "may this card open this door?" at POST /api/pms/door/<token>. A reader tied to a room only
// opens for cards active on that room; a reader with no room (main door, gym) opens for any active card.
model DoorReader {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  roomId     String?
  room       PropertyRoom? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  name       String
  token      String   @unique
  isActive   Boolean  @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime @default(now())
  scans      RoomAccessScan[]

  @@index([storeId, isActive])
  @@index([roomId])
}

model RoomAccessScan {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  readerId  String
  reader    DoorReader @relation(fields: [readerId], references: [id], onDelete: Cascade)
  cardUid   String
  cardId    String?
  allowed   Boolean
  reason    String
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([readerId, createdAt])
}
