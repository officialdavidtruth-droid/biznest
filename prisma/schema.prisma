// ============================================================================
// BizNest -- Prisma Schema
// This file is the single source of truth for the data model. It is split
// conceptually (via comments) into the subsystems described in the product
// spec. Build phases 2+ should extend these models rather than create
// parallel ones.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// AUTH & USERS
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STORE_OWNER
  PLATFORM_ADMIN
  SUPPORT_MODERATOR
}

model User {
  id                String    @id @default(cuid())
  name              String?
  email             String    @unique
  emailVerified     DateTime?
  passwordHash      String? // null for OAuth-only accounts
  image             String?
  role              UserRole  @default(CUSTOMER)
  isBanned          Boolean   @default(false)
  bannedReason      String?
  // Bumped to "now" by the admin force-logout action. Any JWT issued before
  // this timestamp is rejected on its next use (see lib/auth.ts) -- this is
  // what makes "force logout" actually work under a JWT session strategy,
  // where there's no server-side session row to just delete.
  sessionsInvalidatedAt DateTime?
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  phone             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  business          Business?
  orders            Order[]         @relation("BuyerOrders")
  bookings          Booking[]       @relation("BuyerBookings")
  reviews           Review[]
  reviewResponses   ReviewResponse[]
  messages          Message[]
  conversations     ConversationParticipant[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  disputesRaised    Dispute[]       @relation("DisputeRaisedBy")

  @@index([role])
}

// Auth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       VerificationTokenType @default(EMAIL)

  @@unique([identifier, token])
}

enum VerificationTokenType {
  EMAIL
  PASSWORD_RESET
  TWO_FACTOR
}

// ----------------------------------------------------------------------------
// BUSINESS VERIFICATION (KYC)
// ----------------------------------------------------------------------------

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessRegistrationType {
  REGISTERED   // has a business registration certificate
  UNREGISTERED // requires ID + selfie + guarantors
}

model Business {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName          String
  category              String
  description           String                    @db.Text

  // What this business actually sells -- set once at onboarding and driving
  // which dashboard sections/storefront layout are shown. Hybrid stores
  // have both true; every business must have at least one true (enforced
  // in lib/validations/business.ts, not at the DB level, since Prisma
  // can't express a "not both false" constraint).
  sellsProducts         Boolean                   @default(true)
  offersServices        Boolean                   @default(false)
  phone                 String
  email                 String
  country               String
  state                 String
  city                  String

  registrationType      BusinessRegistrationType
  registrationCertUrl   String? // required if REGISTERED
  governmentIdUrl        String? // required if UNREGISTERED
  selfieUrl              String? // required if UNREGISTERED

  fraudPolicyAcceptedAt DateTime?

  verificationStatus    VerificationStatus        @default(PENDING)
  verificationBadge     Boolean                   @default(false)
  reviewedByAdminId     String?
  reviewedAt            DateTime?
  rejectionReason       String?

  guarantors             Guarantor[]
  store                  Store?

  createdAt              DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([verificationStatus])
}

model Guarantor {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  fullName     String
  phone        String
  email        String
  governmentIdUrl String
  relationship String

  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------------
// STORE
// ----------------------------------------------------------------------------

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DomainStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

model Store {
  id            String      @id @default(cuid())
  businessId    String      @unique
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name          String
  slug          String      @unique
  customDomain  String?     @unique
  customDomainStatus DomainStatus @default(NONE)
  status        StoreStatus @default(ACTIVE)

  templateId    String?
  template      StoreTemplate? @relation(fields: [templateId], references: [id])

  logoUrl       String?
  bannerUrl     String?
  themeColors   Json? // { primary, secondary, accent, ... }
  fontFamily    String?
  // Vendor control over which of the template's sections actually show,
  // and in what order -- { hidden: Section[], order: Section[] }. "hero" can
  // never be hidden. A section still won't render if it has no real data
  // behind it regardless of this override (see app/store/[slug]/page.tsx) --
  // this controls arrangement, not fabrication.
  sectionOverrides Json?
  // Click-to-edit hero block overrides (see components/dashboard/hero-block-editor.tsx).
  // { headline?, subtitle?, ctaLabel? } -- all optional; page.tsx falls back to
  // store.name / business.description / theme.cta when a key is absent, so
  // this only overrides what a vendor has actually customized in the visual editor.
  heroOverrides Json?
  // Click-to-edit "story" block overrides (About section) -- same pattern as
  // heroOverrides. { eyebrow?, heading?, body? }. body falls back to
  // business.description, same as before this override existed.
  storyOverrides Json?
  // Image for the Story/About block, set independently via the click-to-edit
  // editor (see components/dashboard/story-block-editor.tsx). Previously the
  // About section silently reused bannerUrl with no way to change it here --
  // this column makes that image its own editable field. Falls back to
  // bannerUrl, then the template's previewUrl, when unset.
  storyImage    String?

  seoTitle      String?
  seoDescription String?

  socialLinks   Json? // { instagram, facebook, twitter, tiktok, whatsapp }
  contactEmail  String?
  contactPhone  String?

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  // Set by a platform admin granting a free trial of a paid plan (see
  // grantUserTrial in lib/actions/admin.ts). While in the future, the store
  // gets that plan's features without actually being billed for it -- this
  // field is purely a marker for admin/UI purposes, not enforced by any
  // billing code path itself. Null means "not on a trial."
  trialEndsAt    DateTime?

  paystackSubaccountCode   String?
  flutterwaveSubaccountId  String?
  // Display-only info the owner entered when connecting payout (bank name,
  // account name, masked number) -- the actual subaccount codes above are
  // what payments are actually split to; this is just what we show them.
  payoutDetails            Json?
  payoutVerifiedAt         DateTime?

  products      Product[]
  services      Service[]
  orders        Order[]
  bookings      Booking[]
  deliveryZones DeliveryZone[]
  newsletterSubscribers NewsletterSubscriber[]
  coupons       Coupon[]
  reviews       Review[]
  pages         StorePage[]
  inventory     InventoryItem[]
  payments      Payment[]

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([status])
}

model StoreTemplate {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Restaurant & Food Delivery -- Midnight Split"
  category    String   // niche, e.g. "Restaurant & Food Delivery" -- many templates share one category
  previewUrl  String?
  config      Json     // full resolved theme: palette, fonts, hero style, sections, catalog label
  tierRank    Int      @default(1) // 1=Free, 2=Entrepreneur, 3=Enterprise, 4=Business Mogul -- a store can pick any template with tierRank <= its plan's rank
  isActive    Boolean  @default(true)

  stores      Store[]
  createdAt   DateTime @default(now())
}

// Website builder pages (Homepage, About, Gallery, FAQ, Blog, Contact, Policies...)
model StorePage {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  slug      String   // "home", "about", "gallery", "faq", "blog", "contact", "policies"
  title     String
  content   Json      // block-based content for the builder
  isPublished Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
}

// ----------------------------------------------------------------------------
// CATALOG: PRODUCTS & SERVICES
// ----------------------------------------------------------------------------

enum ProductType {
  PHYSICAL
  DIGITAL
  RENTAL
}

model Category {
  id       String     @id @default(cuid())
  name     String     @unique
  type     CategoryType
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]
  services Service[]
}

enum CategoryType {
  PRODUCT
  SERVICE
}

model Product {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])

  type         ProductType @default(PHYSICAL)
  name         String
  slug         String
  description  String      @db.Text
  price        Decimal     @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  currency     String      @default("NGN")
  images       String[]
  isPublished  Boolean     @default(true)

  digitalFileUrl String?   // for DIGITAL type
  rentalPeriodUnit String? // "day" | "week" | "month" for RENTAL type
  // Flexible niche-specific fields instead of bloating this table per
  // vertical, e.g. real estate: { bedrooms, bathrooms, areaSqm, address, lat, lng }.
  // Read by the storefront only for niches that know what to do with it
  // (see lib/template-themes.ts) -- absent/unknown keys are ignored.
  attributes     Json?

  inventory    InventoryItem?
  orderItems   OrderItem[]
  reviews      Review[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

model Service {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  name         String
  slug         String
  description  String    @db.Text
  price        Decimal   @db.Decimal(12, 2)
  currency     String    @default("NGN")
  images       String[]
  isPublished  Boolean   @default(true)

  isBookable   Boolean   @default(false) // enables appointments/bookings
  durationMins Int?
  // Weekly availability, e.g. { "mon": [["09:00","17:00"]], "tue": [["09:00","13:00"],["14:00","17:00"]] }.
  // Days omitted are treated as closed. Null means "not configured yet" --
  // the booking widget shows a setup prompt to the vendor instead of guessing hours.
  availability Json?

  bookings     Booking[]
  orderItems   OrderItem[]
  reviews      Review[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

model InventoryItem {
  id         String   @id @default(cuid())
  productId  String   @unique
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  sku        String?
  quantity   Int      @default(0)
  lowStockThreshold Int @default(5)

  updatedAt  DateTime @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model Booking {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  buyerId     String
  buyer       User          @relation("BuyerBookings", fields: [buyerId], references: [id])

  scheduledAt DateTime
  // Redundant with Service.durationMins at booking time, snapshotted so a
  // later change to the service's duration doesn't reshape past bookings.
  durationMins Int
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([serviceId, scheduledAt])
  @@index([storeId])
}

// ----------------------------------------------------------------------------
// ORDERS, PAYMENTS, ESCROW, DISPUTES
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
}

model Order {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  buyerId       String
  buyer         User          @relation("BuyerOrders", fields: [buyerId], references: [id])

  status        OrderStatus   @default(PENDING_PAYMENT)
  subtotal      Decimal       @db.Decimal(12, 2)
  commission    Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("NGN")

  paymentProvider PaymentProvider?
  paymentReference String?
  escrowReleasedAt DateTime?

  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  deliveryFee    Decimal       @db.Decimal(12, 2) @default(0)

  items         OrderItem[]
  dispute       Dispute?
  conversation  Conversation?
  payments      Payment[]

  shippingAddress Json?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([storeId])
  @@index([buyerId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
}

// One row per real charge attempt against a payment gateway -- the audit
// trail and reconciliation source of truth that used to live only as a
// couple of fields on Order. An order can have more than one Payment row
// over its life (a failed attempt followed by a successful retry); Order's
// own paymentProvider/paymentReference fields stay in place as a fast
// "what actually got it PAID" pointer, but this table is where every
// attempt -- successful or not -- gets recorded, along with the raw gateway
// payload for debugging and dispute evidence.
model Payment {
  id          String          @id @default(cuid())

  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  // Subscription-upgrade payments aren't tied to an Order, only a Store --
  // set for both purposes so a store's full payment history (orders +
  // subscription upgrades) can be queried from one place.
  storeId     String?
  store       Store?          @relation(fields: [storeId], references: [id])

  purpose     PaymentPurpose
  provider    PaymentProvider
  // The value passed to the gateway as reference/tx_ref, and the value both
  // the callback route and the webhook look this row up by. Unique because
  // each charge attempt gets its own reference (order checkout: the order's
  // id; subscription upgrade: the SUBUP-... string built in
  // lib/actions/subscription.ts).
  reference   String          @unique
  status      PaymentStatus   @default(PENDING)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("NGN")

  // Full verify-endpoint response body from whichever route last touched
  // this row (browser callback or webhook) -- kept for debugging and as
  // evidence if a dispute/chargeback needs to be investigated later.
  rawPayload  Json?
  // Set the first time server-side verification against the gateway
  // succeeds -- null while still PENDING.
  verifiedAt  DateTime?

  // Refund tracking, set when a support/admin agent issues a refund
  // against this charge (see lib/actions/refund.ts). refundReference is
  // the gateway's own refund id -- unique so the same charge can't somehow
  // collect two successful refund rows. refundedAmount lets a future
  // partial-refund flow reuse this same table without a schema change.
  refundReference   String?   @unique
  refundedAmount    Decimal?  @db.Decimal(12, 2)
  refundReason      String?
  refundedByEmail   String?
  refundedAt        DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([orderId])
  @@index([storeId])
  @@index([status])
}

enum PaymentPurpose {
  ORDER
  SUBSCRIPTION_UPGRADE
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

model Dispute {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  raisedById    String
  raisedBy      User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])

  reason        String        @db.Text
  evidenceUrls  String[]
  status        DisputeStatus @default(OPEN)
  adminNotes    String?

  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?
}

// Local delivery pricing for physical-goods stores (food, groceries, etc.).
// A store with no zones defined is treated as "delivery not offered yet" --
// checkout falls back to pickup/no shipping fee rather than blocking sale.
model DeliveryZone {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name             String   // e.g. "Wuse & Garki", "Lekki Phase 1"
  fee              Decimal  @db.Decimal(12, 2)
  estimatedMinutes Int?
  isActive         Boolean  @default(true)

  orders           Order[]

  createdAt        DateTime @default(now())

  @@index([storeId])
}

// Newsletter signups collected from a store's storefront (opt-in "Newsletter"
// section -- see lib/template-themes.ts Section type). Real capture, not
// decorative -- a vendor can export/see these, distinct from platform users.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())

  @@unique([storeId, email])
  @@index([storeId])
}

model Coupon {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  code        String
  discountType String  // "PERCENT" | "FIXED"
  discountValue Decimal @db.Decimal(12, 2)
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)

  @@unique([storeId, code])
}

// ----------------------------------------------------------------------------
// REVIEWS
// ----------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  rating     Int      // 1-5
  comment    String?  @db.Text
  images     String[]
  videos     String[]

  response   ReviewResponse?

  createdAt  DateTime @default(now())
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// MESSAGING
// ----------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id])

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  content        String       @db.Text
  attachmentUrls String[]
  readAt         DateTime?

  createdAt      DateTime     @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "ORDER_UPDATE" | "MESSAGE" | "VERIFICATION" | ...
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------------
// SUBSCRIPTIONS / PLATFORM SETTINGS / AUDIT
// ----------------------------------------------------------------------------

model Subscription {
  id        String   @id @default(cuid())
  name      String   @unique // "Free" | "Entrepreneur" | "Enterprise" | "Business Mogul"
  price     Decimal  @db.Decimal(12, 2)
  interval  String   // "MONTHLY" | "YEARLY"
  features  Json     // { products, services, customDomain } -- -1 means unlimited
  commissionRate Decimal @db.Decimal(5, 2) @default(0) // percentage
  isActive  Boolean  @default(true) // retired plans are hidden from pricing/upgrade UI, not deleted -- a store may still reference one

  stores    Store[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

model PlatformSetting {
  id    String @id @default(cuid())
  key   String @unique
  value Json
}

// Generic rate limiter, keyed by e.g. "register:203.0.113.5" or
// "login:someone@example.com". No Redis needed at this scale -- a row per
// key with a rolling window is more than enough for tens of thousands of
// requests/day on Postgres.
model RateLimitEntry {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}
