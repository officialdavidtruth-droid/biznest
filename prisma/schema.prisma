  ownGatewayEnabled        Boolean   @default(false)
  ownGatewayProvider       PaymentProvider?
  ownPaystackSecretKey     String?
  ownPaystackPublicKey     String?
  ownFlutterwaveSecretKey  String?
  ownFlutterwavePublicKey  String?
  // Webhook secret hash BizNest generates; the merchant pastes it into their
