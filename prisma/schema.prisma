// ============================================================================
// BizNest -- Prisma Schema
// This file is the single source of truth for the data model. It is split
// conceptually (via comments) into the subsystems described in the product
// spec. Build phases 2+ should extend these models rather than create
// parallel ones.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------------------------------
// AUTH & USERS
// ----------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  STORE_OWNER
  PLATFORM_ADMIN
  SUPPORT_MODERATOR
}

model User {
  id                String    @id @default(cuid())
  name              String?
  // No longer globally @unique -- see customerScopeStoreId below. Owners,
  // staff, and platform admins keep a single global identity (scope null)
  // and remain unique among themselves; a customer account is scoped to
  // one specific store, so the same email can independently register as a
  // completely separate account (own password, own identity) at any
  // number of different stores. Enforced by the composite unique index
  // below, plus a partial unique index (added via raw SQL migration,
  // since Prisma's schema DSL can't express a WHERE-scoped unique index)
  // that keeps scope-null (platform) rows globally unique the same as
  // before.
  email             String
  // Null = a platform-level identity (store owner, staff, platform admin,
  // or a pending signup awaiting business verification -- see registerUser
  // in lib/actions/auth.ts). Set to a specific Store's id = this row is
  // that store's customer account for this email, fully independent from
  // any account of the same email at any other store.
  customerScopeStoreId String?
  customerScopeStore   Store?  @relation("UserCustomerScope", fields: [customerScopeStoreId], references: [id], onDelete: Cascade)
  emailVerified     DateTime?
  passwordHash      String? // null for OAuth-only accounts
  image             String?
  role              UserRole  @default(CUSTOMER)
  isBanned          Boolean   @default(false)
  bannedReason      String?
  // Bumped to "now" by the admin force-logout action. Any JWT issued before
  // this timestamp is rejected on its next use (see lib/auth.ts) -- this is
  // what makes "force logout" actually work under a JWT session strategy,
  // where there's no server-side session row to just delete.
  sessionsInvalidatedAt DateTime?
  failedLoginAttempts Int     @default(0)
  lockedUntil       DateTime?
  twoFactorEnabled  Boolean   @default(false)
  twoFactorSecret   String?
  phone             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  accounts          Account[]
  sessions          Session[]
  business          Business?
  orders            Order[]         @relation("BuyerOrders")
  bookings          Booking[]       @relation("BuyerBookings")
  reviews           Review[]
  reviewResponses   ReviewResponse[]
  messages          Message[]
  conversations     ConversationParticipant[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
  staffMemberships  StoreStaff[]
  auditLogs         AuditLog[]
  disputesRaised    Dispute[]       @relation("DisputeRaisedBy")
  disputeEvidence   DisputeEvidence[]

  // --- Customer account system (additive) ---
  addresses         Address[]
  storeAddresses    StoreCustomerAddress[]
  storeMemberships  StoreCustomer[]
  customerProfiles  StoreCustomerProfile[]
  wishlistItems     WishlistItem[]
  recentlyViewed    RecentlyViewed[]
  favoriteBusinesses FavoriteBusiness[]
  storeLoyaltyAccounts StoreLoyaltyAccount[]
  savedCarts        SavedCart[]

  // --- Loyalty / invoicing / quotations (additive) ---
  loyaltyAccount    LoyaltyAccount?
  invoices          Invoice[]
  quotes            Quote[]

  @@index([role])
  // Enforces "unique email per scope": a store-scoped customer's email is
  // unique within that one store, independent of every other store. Note
  // this alone does NOT enforce uniqueness among scope-null (platform)
  // rows -- Postgres treats every NULL as distinct, so two owner accounts
  // could otherwise share an email. That's covered separately by a
  // partial unique index added via raw SQL in this same migration.
  @@unique([email, customerScopeStoreId])
}


model StoreCustomerAddress {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String   @default("Nigeria")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([storeId, userId])
  @@index([storeId, userId, isDefault])
}

model StoreLoyaltyAccount {
  id            String         @id @default(cuid())
  storeId       String
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance Int            @default(0)
  entries       StoreLoyaltyEntry[]
  updatedAt     DateTime       @updatedAt

  @@unique([storeId, userId])
  @@index([storeId])
}

model StoreLoyaltyEntry {
  id                 String             @id @default(cuid())
  loyaltyAccountId   String
  loyaltyAccount     StoreLoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  orderId            String?
  order              Order?             @relation(fields: [orderId], references: [id])
  type               LoyaltyEntryType
  points             Int
  note               String?
  createdAt          DateTime           @default(now())

  @@index([loyaltyAccountId, createdAt])
  @@index([orderId, type])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  // "Home", "Office"
  fullName  String
  phone     String
  line1     String
  line2     String?
  city      String
  state     String
  country   String   @default("Nigeria")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId, serviceId])
  @@index([userId])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@index([userId, viewedAt])
}

model FavoriteBusiness {
  id         String   @id @default(cuid())
  storeId    String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, businessId])
}

model SavedCart {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items     Json     // [{ productId, quantity }]
  updatedAt DateTime @updatedAt

  @@unique([userId, storeId])
}

// A customer's account is scoped to the one store they signed up through —
// signing up with Store A does not grant sign-in access to Store B. This
// is separate from StoreStaff (which is store-scoped employment) and from
// User.role (a platform-level role like STORE_OWNER) -- this table is the
// one source of truth for "is this person actually a customer of this
// specific store", and lib/auth.ts's Credentials authorize() checks it on
// every store-context login.
model StoreCustomerProfile {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([storeId, createdAt])
  @@index([storeId, phone])
  @@index([storeId, email])
  @@index([userId])
}

model StoreCustomer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, storeId])
  @@index([storeId])
}

// Auth.js required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  type       VerificationTokenType @default(EMAIL)

  @@unique([identifier, token])
}

enum VerificationTokenType {
  EMAIL
  PASSWORD_RESET
  TWO_FACTOR
}

// ----------------------------------------------------------------------------
// BUSINESS VERIFICATION (KYC)
// ----------------------------------------------------------------------------

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum BusinessRegistrationType {
  REGISTERED   // has a business registration certificate
  UNREGISTERED // requires ID + selfie + guarantors
}

model Business {
  id                    String                    @id @default(cuid())
  userId                String                    @unique
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName          String
  category              String
  description           String                    @db.Text

  // What this business actually sells -- set once at onboarding and driving
  // which dashboard sections/storefront layout are shown. Hybrid stores
  // have both true; every business must have at least one true (enforced
  // in lib/validations/business.ts, not at the DB level, since Prisma
  // can't express a "not both false" constraint).
  sellsProducts         Boolean                   @default(true)
  offersServices        Boolean                   @default(false)
  phone                 String
  email                 String
  country               String
  state                 String
  city                  String

  registrationType      BusinessRegistrationType
  registrationCertUrl   String? // required if REGISTERED
  governmentIdUrl        String? // required if UNREGISTERED
  selfieUrl              String? // required if UNREGISTERED

  fraudPolicyAcceptedAt DateTime?

  verificationStatus    VerificationStatus        @default(PENDING)
  verificationBadge     Boolean                   @default(false)
  reviewedByAdminId     String?
  reviewedAt            DateTime?
  rejectionReason       String?

  // --- Marketplace discovery fields (additive; existing rows default in) ---
  latitude              Float?
  longitude             Float?
  // Search visibility, kept independent of verificationStatus/verificationBadge
  // so admins can suppress a business from platform-wide discovery without
  // touching its trust/verification record.
  searchVisible         Boolean                   @default(true)
  // Denormalized from Review, recomputed on review create/update/delete
  // (see lib/actions/reviews.ts) -- avoids aggregating Review on every
  // search request. Null/0 until the recompute job/backfill runs.
  avgRating             Float?
  reviewCount           Int                       @default(0)

  // Denormalized copy of getTrustScoreBreakdown(...).score (see
  // lib/actions/trust-score.ts). The dashboard still computes the full
  // breakdown live; this column exists only so marketplace search can
  // sort/filter by Trust Score without recomputing it per row. Kept in
  // sync by recomputeAndPersistTrustScore() -- see that file for which
  // write paths trigger a refresh and the accepted staleness window.
  trustScore            Int?
  trustScoreUpdatedAt   DateTime?
  guarantors             Guarantor[]
  store                  Store?
  favoritedBy            FavoriteBusiness[]

  createdAt              DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([verificationStatus])
  @@index([category])
  @@index([city, state])
  @@index([latitude, longitude])
  @@index([trustScore])
}

model Guarantor {
  id           String   @id @default(cuid())
  businessId   String
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  fullName     String
  phone        String
  email        String
  governmentIdUrl String
  relationship String

  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------------
// STORE
// ----------------------------------------------------------------------------

enum StoreStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum DomainStatus {
  NONE
  PENDING
  VERIFIED
  FAILED
}

model Store {
  id            String      @id @default(cuid())
  businessId    String      @unique
  business      Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name          String
  slug          String      @unique
  customDomain  String?     @unique
  customDomainStatus DomainStatus @default(NONE)
  status        StoreStatus @default(ACTIVE)

  templateId    String?
  template      StoreTemplate? @relation(fields: [templateId], references: [id])

  webhookEndpoints WebhookEndpoint[]

  logoUrl       String?
  bannerUrl     String?
  themeColors   Json? // { primary, secondary, accent, ... }
  fontFamily    String?
  // Vendor control over which of the template's sections actually show,
  // and in what order -- { hidden: Section[], order: Section[] }. "hero" can
  // never be hidden. A section still won't render if it has no real data
  // behind it regardless of this override (see app/store/[slug]/page.tsx) --
  // this controls arrangement, not fabrication.
  // Per-store sequential counters for human-facing document numbers
  // (e.g. "BN-INV-7" for a store's 7th invoice). Incremented inside the
  // same transaction that creates the Invoice/Quote row to avoid races.
  nextInvoiceNo Int @default(1)
  nextQuoteNo   Int @default(1)
  nextPoNo      Int @default(1)

  sectionOverrides Json?
  // Industry-specific answers captured during store onboarding. The object
  // is intentionally flexible because each business type asks different
  // setup questions (hotel rooms, salon team size, delivery area, etc.).
  onboardingProfile Json?
  // Click-to-edit hero block overrides (see components/dashboard/hero-block-editor.tsx).
  // { headline?, subtitle?, ctaLabel? } -- all optional; page.tsx falls back to
  // store.name / business.description / theme.cta when a key is absent, so
  // this only overrides what a vendor has actually customized in the visual editor.
  heroOverrides Json?
  // Click-to-edit "story" block overrides (About section) -- same pattern as
  // heroOverrides. { eyebrow?, heading?, body? }. body falls back to
  // business.description, same as before this override existed.
  storyOverrides Json?
  // Image for the Story/About block, set independently via the click-to-edit
  // editor (see components/dashboard/story-block-editor.tsx). Previously the
  // About section silently reused bannerUrl with no way to change it here --
  // this column makes that image its own editable field. Falls back to
  // bannerUrl, then the template's previewUrl, when unset.
  storyImage    String?

  seoTitle      String?
  seoDescription String?

  socialLinks   Json? // { instagram, facebook, twitter, tiktok, whatsapp }
  contactEmail  String?
  contactPhone  String?

  subscriptionId String?
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  // Set by a platform admin granting a free trial of a paid plan (see
  // grantUserTrial in lib/actions/admin.ts). While in the future, the store
  // gets that plan's features without actually being billed for it -- this
  // field is purely a marker for admin/UI purposes, not enforced by any
  // billing code path itself. Null means "not on a trial."
  trialEndsAt    DateTime?

  // --- Recurring billing state (see app/api/cron/subscription-renewals) ---
  // Paystack's reusable authorization_code from the store owner's first
  // successful checkout -- lets the renewal cron charge_authorization each
  // month with no card re-entry. Null until the first successful payment;
  // also null again if a saved card is ever declined outright (Paystack
  // marks non-reusable authorizations as unusable for future charges).
  paystackAuthorizationCode String?
  // When the current paid period ends and the next automatic charge is due.
  // Null for stores that haven't completed checkout yet (see
  // app/onboarding/select-plan). Set on both the first payment and every
  // successful renewal.
  subscriptionRenewsAt      DateTime?
  // Set the first time a renewal charge fails; cleared on the next
  // successful charge. Distinct from subscriptionRenewsAt so the renewal
  // cron can tell "due today" apart from "already tried and failed" and
  // apply grace-period/downgrade logic without re-deriving state.
  subscriptionPastDueSince  DateTime?

  paystackSubaccountCode   String?
  flutterwaveSubaccountId  String?
  // Display-only info the owner entered when connecting payout (bank name,
  // account name, masked number) -- the actual subaccount codes above are
  // what payments are actually split to; this is just what we show them.
  payoutDetails            Json?
  payoutVerifiedAt         DateTime?

  // Running 
