  registration String
  make        String?
  model       String?
  year        Int?
  customerName String?
  customerPhone String?
  mileage     Int?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([storeId, registration])
  @@index([storeId, customerPhone])
}

model PhotoShoot {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  shootDate   DateTime?
  status      String   @default("PLANNED")
  clientName  String?
  clientEmail String?
  proofUrl    String?
  finalUrl    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([storeId, status, shootDate])
}

// A photographer's (or any creative's) public portfolio: albums such as "Weddings" or "Portraits", each holding images.
// Images are display copies hosted on Cloudinary. Final client deliveries stay as pasted links (JobCard.deliverableUrl).
model PortfolioAlbum {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  category    String?
  description String?
  coverUrl    String?
  isPublished Boolean  @default(true)
  sortOrder   Int      @default(0)
