// Records every slug a store used to have, so a shopper or bookmarked link
// (biznest.space/<old-slug>) keeps working after the owner shortens/renames
// their storefront URL. See updateStoreSlug in lib/actions/store.ts (writes
// a row here on every change) and app/store/[slug]/layout.tsx (reads it to
// redirect old links to the store's current slug). oldSlug is unique so a
// retired slug can never be handed to a *different* store while it's still
// acting as a redirect target for this one.
model StoreSlugHistory {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  oldSlug   String   @unique
  createdAt DateTime @default(now())

  @@index([storeId])
}

enum StaffRole {
  MANAGER // Full dashboard access except billing/subscription and staff management
  STAFF   // Products, services, orders, messages -- no settings, billing, or staff
}

enum StaffInviteStatus {
  PENDING
  ACTIVE
  REVOKED
}

// A non-owner user with access to a store's dashboard. Ownership itself
// (Business.userId) is unchanged and still the only role that can manage
// billing/subscription or invite/revoke staff -- see
// lib/access/store-access.ts, the single source of truth for "can this
// user touch this store" that both the dashboard layout gate and
// individual server actions should call instead of re-deriving ownership
// logic ad hoc.
//
// Invite flow: owner invites by email (userId null, status PENDING) ->
// invitee visits /staff/accept?token=... while logged in with a matching
// email -> userId set, status ACTIVE. See lib/actions/staff.ts.
model StoreStaff {
  id            String             @id @default(cuid())
  storeId       String
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)

  invitedEmail  String?
  invitedName   String?
  position      String?
  // Login handle the admin sets directly at invite time (paired with
  // store slug: username@store-slug — see the Credentials authorize()
  // block in lib/auth.ts). Distinct from `position` so two staff can
  // share a job title ("Cashier") without colliding on login.
  username      String?
  permissions   String[]           @default([])
  userId        String?
  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)

  bookings      Booking[]
  serviceLinks  ServiceStaff[]
  hrEmployee    HrEmployee?

  role          StaffRole          @default(STAFF)
  status        StaffInviteStatus  @default(PENDING)

  inviteToken   String             @unique
  invitedByUserId String
  invitedAt     DateTime           @default(now())
  acceptedAt    DateTime?

  @@unique([storeId, invitedEmail])
  @@unique([storeId, username])
  @@index([userId])
  @@index([inviteToken])
}

// Append-only audit trail of what staff/managers (and the owner) did
// inside a store's dashboard, so the owner has visibility into actions
// taken by people they've delegated access to. Written via
// logStoreActivity() in lib/actions/activity.ts — see that file for the
// list of instrumented actions. Never updated or deleted, only inserted.
model StoreActivityLog {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  actorUserId String?
  actorName   String
  actorEmail  String
  actorRole   String

  action      String
  target      String?
  metadata    Json?

  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
}

model StoreTemplate {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Restaurant & Food Delivery -- Midnight Split"
  category    String   // niche, e.g. "Restaurant & Food Delivery" -- many templates share one category
  previewUrl  String?
  config      Json     // full resolved theme: palette, fonts, hero style, sections, catalog label
  tierRank    Int      @default(1) // 1=Free, 2=Entrepreneur, 3=Enterprise, 4=Business Mogul -- a store can pick any template with tierRank <= its plan's rank
  isActive    Boolean  @default(true)

  stores      Store[]
  createdAt   DateTime @default(now())
}

// Website builder pages (Homepage, About, Gallery, FAQ, Blog, Contact, Policies...)
model StorePage {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  slug      String   // "home", "about", "gallery", "faq", "blog", "contact", "policies"
  title     String
  content   Json      // block-based content for the builder
  isPublished Boolean @default(true)

  updatedAt DateTime @updatedAt

  @@unique([storeId, slug])
}

// ----------------------------------------------------------------------------
// CATALOG: PRODUCTS & SERVICES
// ----------------------------------------------------------------------------

enum ProductType {
  PHYSICAL
  DIGITAL
  RENTAL
}

model Category {
  id       String     @id @default(cuid())
  // Null is retained only for legacy platform categories during migration; all store-owned categories are scoped to one store.
  storeId  String?
  store    Store?     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name     String
  // URL segment for /store/[slug]/category/[slug]. Unique within a store, stays the same when the category is
  // renamed (like WordPress), and is nullable only so legacy platform categories (storeId null) need no value.
  // Old /category/<id> links keep working: the route accepts either and redirects ids to the slug URL.
  slug     String?
  description String?
  type     CategoryType
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  imageUrl  String?
  icon      String?
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  // Defines which Product/Service.attributes keys are filterable for this
  // category and how the discovery UI should render/query them. Read only
  // by the marketplace filter panel -- never enforced at the DB level, same
  // pattern as Product.attributes itself. Null = no filter panel yet.
  filterSchema Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
  services Service[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, parentId])
}

// Logged platform-wide marketplace searches, for ranking and analytics.
// Independent of Business/Store -- purely additive, no FK on existing tables.
model SearchQuery {
  id                String   @id @default(cuid())
  rawQuery          String?
  category          String?
  city              String?
  state             String?
  resultCount       Int
  clickedBusinessId String?
  createdAt         DateTime @default(now())

  @@index([category, city])
  @@index([createdAt])
}

enum CategoryType {
  PRODUCT
  SERVICE
}

model Product {
  id           String      @id @default(cuid())
  storeId      String
  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])

  type         ProductType @default(PHYSICAL)
  name         String
  slug         String
  description  String      @db.Text
  price        Decimal     @db.Decimal(12, 2)
  compareAtPrice Decimal?  @db.Decimal(12, 2)
  currency     String      @default("NGN")
  images       String[]
  isPublished  Boolean     @default(true)
  // Set when a product that has orders/stock history was "deleted": it is kept
  // for its records but hidden everywhere, and no longer counts toward the
  // plan's product limit. Cleared when the merchant restores or republishes it.
  archivedAt   DateTime?

  digitalFileUrl String?   // for DIGITAL type
  rentalPeriodUnit String? // "day" | "week" | "month" for RENTAL type
  // Flexible niche-specific fields instead of bloating this table per
  // vertical, e.g. real estate: { bedrooms, bathrooms, areaSqm, address, lat, lng }.
  // Read by the storefront only for niches that know what to do with it
  // (see lib/template-themes.ts) -- absent/unknown keys are ignored.
  attributes     Json?

  // True once this product has at least one ProductVariant. Existing
  // single-SKU products keep using the InventoryItem below unchanged --
  // variants only kick in once the merchant opts in, so nothing about
  // simple products has to change.
  hasVariants  Boolean     @default(false)
  // Pre-order mode: sells without touching stock, with an optional expected ship date and unit cap.
  // See lib/preorder.ts. Dedicated columns (not `attributes`) because the product form rewrites attributes wholesale.
  preorderEnabled  Boolean   @default(false)
  preorderShipsOn  DateTime? @db.Date
  preorderLimit    Int?
  // Defines the option axes for this product's variants, e.g.
  // [{ "name": "Size", "values": ["S","M","L"] }, { "name": "Color", "values": ["Red","Blue"] }].
  // Purely descriptive -- used to render the variant matrix in the editor;
  // each ProductVariant.optionValues carries its own resolved combo.
  variantOptions Json?

  inventory    InventoryItem?
  variants     ProductVariant[]
  addonGroups  ProductAddonGroup[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  viewedBy     RecentlyViewed[]
  supplierLinks    SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]
  requisitionItems RequisitionItem[]

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, archivedAt])
}

// One row per sellable size/color/etc combo of a variant-enabled product.
// Each variant carries its own SKU, barcode, price override, and stock --
// mirroring InventoryItem's fields rather than reusing it, since a variant
// isn't a standalone product and needs the optionValues/product link
// instead of a 1:1 product relation.
model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Resolved combo for this variant, e.g. { "Size": "M", "Color": "Blue" }.
  optionValues Json
  // Human-readable label built from optionValues (e.g. "M / Blue"), stored
  // so listings/order history don't need to recompute it from the option
  // schema, which may change after the order was placed.
  label        String

  sku          String?
  barcode      String?
  // Null means "use the parent product's price" -- most variants (e.g. a
  // plain size change) don't need their own price, only ones that actually
  // cost more/less (e.g. a larger size) set this.
  price        Decimal? @db.Decimal(12, 2)
  images       String[]
  isActive     Boolean  @default(true)

  quantity     Int      @default(0)
  lowStockThreshold Int @default(5)
  costPrice    Decimal? @db.Decimal(12, 2)
  autoUnpublished Boolean @default(false)

  movements    StockMovement[]
  batches      InventoryBatch[]
  orderItems   OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  requisitionItems RequisitionItem[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
  @@index([productId])
  @@index([storeId])
}

// A configurable group of extras attached to one product, e.g. "Choose your
// side" or "Extra toppings" for a menu item, or "Gift wrap" for a retail
// product -- generic across any product-selling niche, not restaurant-only.
model ProductAddonGroup {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name      String
  // How many options a buyer must/can pick from this group. minSelect = 0
  // means optional; maxSelect = null means unlimited.
  minSelect Int           @default(0)
  maxSelect Int?
  sortOrder Int           @default(0)
  isActive  Boolean       @default(true)

  addons    ProductAddon[]

  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([productId])
  @@index([storeId])
}

model ProductAddon {
  id       String            @id @default(cuid())
  groupId  String
  group    ProductAddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  storeId  String
  store    Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name     String
  // Extra charge for this option, e.g. ₦500 for extra cheese. 0 for a free
  // choice that doesn't change price (e.g. a spice-level pick).
  price    Decimal           @default(0) @db.Decimal(12, 2)
  isActive Boolean           @default(true)
  sortOrder Int              @default(0)

  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([groupId])
  @@index([storeId])
}

model Service {
  id           String    @id @default(cuid())
  storeId      String
  store        Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id])

  name         String
  slug         String
  description  String    @db.Text
  price        Decimal   @db.Decimal(12, 2)
  currency     String    @default("NGN")
  images       String[]
  isPublished  Boolean   @default(true)

  isBookable   Boolean   @default(false) // enables appointments/bookings
  durationMins Int?
  // Flexible niche-specific fields (tags, featured/taxable/special-request
  // toggles, quick specs, spec panel, custom key/value pairs), mirroring
  // Product.attributes. Lets ServiceForm reuse the same niche-preset system
  // as ProductForm (lib/catalog-item-presets.ts) without a migration per
  // vertical -- a hotel room, a salon appointment, and a consultation all
  // read/write this the same way.
  attributes   Json?
  // Weekly availability, e.g. { "mon": [["09:00","17:00"]], "tue": [["09:00","13:00"],["14:00","17:00"]] }.
  // Days omitted are treated as closed. Null means "not configured yet" --
  // the booking widget shows a setup prompt to the vendor instead of guessing hours.
  availability Json?

  // Set for unit-based services (e.g. a hotel room category with 12
  // identical rooms, a rental fleet with 5 identical cars). When set, this
  // many ServiceUnit rows exist under this service and bookings attach to
  // a specific unit + date range instead of using weekly availability.
  // Null means a plain appointment-style service (unchanged behavior).
  totalUnits   Int?

  units        ServiceUnit[]
  bookings     Booking[]
  staffLinks   ServiceStaff[]
  orderItems   OrderItem[]
  reviews      Review[]
  wishlistedBy WishlistItem[]
  viewedBy     RecentlyViewed[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
}

enum ServiceUnitStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  DIRTY
  CLEANING
  MAINTENANCE
  OUT_OF_SERVICE
}

model ServiceUnit {
  id        String            @id @default(cuid())
  storeId   String
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  serviceId String
  service   Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  // e.g. "101", "Unit 3" -- shown to housekeeping/staff and on the calendar.
  label     String
  status    ServiceUnitStatus @default(AVAILABLE)
  // Free-text zone, e.g. "Indoor"/"Outdoor" for a restaurant table,
  // "Floor 2" for a hotel room. Purely descriptive, shown next to the
  // label wherever units are listed.
  location  String?
  // Max occupancy for this unit (table seats, room max guests). Optional --
  // niches that don't track capacity per unit just leave it unset.
  capacity  Int?

  bookings  Booking[]
  // PMS room that is this same physical room (see PropertyRoom.serviceUnitId).
  propertyRoom PropertyRoom?

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([serviceId, label])
  @@index([storeId, status])
}

model ServiceStaff {
  id        String      @id @default(cuid())
  serviceId String
  service   Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  staffId   String
  staff     StoreStaff  @relation(fields: [staffId], references: [id], onDelete: Cascade)

  createdAt DateTime     @default(now())

  @@unique([serviceId, staffId])
  @@index([staffId])
}

model InventoryItem {
  id         String   @id @default(cuid())
  productId  String   @unique
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  sku        String?
  barcode    String?
  quantity   Int      @default(0)
  lowStockThreshold Int @default(5)
  // What the merchant paid per unit -- optional since older/existing items
  // won't have this set until the merchant fills it in. Powers the
  // profit/margin figures on the inventory dashboard; never shown to buyers.
  costPrice  Decimal? @db.Decimal(12, 2)
  // True only when the out-of-stock automation (not the merchant) took this
  // product's listing down, so a later restock knows it's safe to
  // auto-republish -- see adjustStock in lib/actions/inventory.ts. A
  // merchant who manually unpublishes a well-stocked item never has this
  // set, so restocking never overrides their own choice.
  autoUnpublished Boolean @default(false)

  movements  StockMovement[]
  batches    InventoryBatch[]

  updatedAt  DateTime @updatedAt

  @@unique([storeId, sku])
  @@unique([storeId, barcode])
}

// Append-only ledger of every quantity change on an InventoryItem -- the
// "Stock history" merchants see per product. Written by adjustStock, never
// mutated after the fact, so it stays a trustworthy audit trail even if the
// current quantity is later corrected.
model StockMovement {
  id              String            @id @default(cuid())
  // Exactly one of inventoryItemId / variantId is set, matching whichever
  // kind of stock this movement adjusted -- a plain product's InventoryItem,
  // or one ProductVariant of a variant-enabled product.
  inventoryItemId String?
  inventoryItem   InventoryItem?    @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  variantId       String?
  variant         ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Order that caused this movement. Set for automatic SALE movements so
  // a retry/replay can never decrement the same order twice.
  orderId         String?
  order           Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  type            StockMovementType
  batchConsumptions InventoryBatchConsumption[]
  // Signed delta applied by this movement (+10 restock, -1 sale, etc).
  quantityChange  Int
  // Resulting on-hand quantity right after this movement, so history reads
  // as a running balance without recomputing from the full ledger.
  quantityAfter   Int
  note            String?

  createdAt       DateTime          @default(now())

  @@index([inventoryItemId, createdAt])
  @@index([variantId, createdAt])
  @@index([storeId])
  @@index([orderId])
}


// FIFO inventory lots/batches. Every positive stock receipt creates a batch
// carrying its own cost and optional expiry date. Sales and other negative
// stock movements consume the oldest remaining batches first. This gives FnB
// operators traceability for perishables and an auditable cost basis.
model InventoryBatch {
  id               String          @id @default(cuid())
  storeId          String
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  inventoryItemId  String?
  inventoryItem    InventoryItem?  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  variantId        String?
  variant          ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)

  batchNumber      String?
  quantityReceived Int
  quantityRemaining Int
  unitCost         Decimal?        @db.Decimal(12, 2)
  receivedAt       DateTime        @default(now())
  expiryDate       DateTime?
  sourceNote       String?

  consumptions     InventoryBatchConsumption[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([storeId, inventoryItemId, receivedAt, id])
  @@index([storeId, variantId, receivedAt, id])
  @@index([expiryDate])
  @@index([purchaseOrderItemId])
}

// Immutable allocation ledger: exactly how much of each FIFO batch was
// consumed by a stock movement. This is the basis for batch traceability and
// FIFO COGS reporting.
model InventoryBatchConsumption {
  id               String         @id @default(cuid())
  inventoryBatchId String
  inventoryBatch   InventoryBatch @relation(fields: [inventoryBatchId], references: [id], onDelete: Cascade)
  stockMovementId  String
  stockMovement    StockMovement  @relation(fields: [stockMovementId], references: [id], onDelete: Cascade)
  quantity         Int
  unitCost         Decimal?       @db.Decimal(12, 2)
  createdAt        DateTime       @default(now())

  @@index([inventoryBatchId, createdAt])
  @@index([stockMovementId])
}

enum StockMovementType {
  RESTOCK
  SALE
  RETURN
  MANUAL_ADJUSTMENT
  CORRECTION
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  // Front-of-house pipeline states used by unit-based reservations (a
  // restaurant table, a hotel room) between "confirmed" and "completed" --
  // optional for niches that don't need them (appointment-style bookings
  // just skip straight from CONFIRMED to COMPLETED).
  CHECKED_IN
  SEATED
  NO_SHOW
}

// NOTE: a partial unique index — ("serviceId","staffId","scheduledAt") WHERE
// status <> 'CANCELLED' AND "staffId" IS NOT NULL — exists on this table via
// prisma/migrations/20260828170000_booking_slot_unique_constraint. Prisma's
// schema syntax can't express a partial index, so it isn't declared with
// @@unique here, but it's live in the database and is what actually
// prevents two customers from double-booking the same staff member's slot
// (see the P2002 catch in createBooking, lib/actions/booking.ts).
model Booking {
  id          String        @id @default(cuid())
  storeId     String
  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  serviceId   String
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  // Nullable: a staff-created walk-in booking (e.g. a hotel guest checked in
  // at the front desk) has no BizNest customer account to attach. Guest
  // details are captured directly on the booking instead (below).
  buyerId     String?
  buyer       User?         @relation("BuyerBookings", fields: [buyerId], references: [id])

  // Set for unit-based bookings (e.g. a specific hotel room under a room
  // category). Null for plain appointment-style services.
  unitId      String?
  unit        ServiceUnit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)

  staffId     String?
  staff       StoreStaff?  @relation(fields: [staffId], references: [id], onDelete: SetNull)

  scheduledAt DateTime
  // Redundant with Service.durationMins at booking time, snapshotted so a
  // later change to the service's duration doesn't reshape past bookings.
  durationMins Int
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  // Set once the automatic review request has gone out for this booking.
  reviewRequestedAt DateTime?

  // Multi-day stay range, used for unit-based bookings (checkIn/checkOut)
  // instead of a single scheduledAt+durationMins slot. Null for
  // appointment-style bookings.
  checkIn     DateTime?
  checkOut    DateTime?

  // Guest details, captured directly on the booking so front-desk staff can
  // create a booking without the guest having an account. All optional so
  // existing appointment-style bookings are unaffected.
  guestName             String?
  guestPhone            String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // Generic party-size + free-text requests, usable by any unit-based
  // reservation niche (a restaurant table for 4, a hotel room for a family
  // of 3, a salon chair for a group booking) -- not restaurant-specific.
  partySize             Int?
  specialRequests       String[]        @default([])
  governmentIdType      String?
  governmentIdNumber    String?
  governmentIdImageUrl  String?

  // How this reservation came in (e.g. "Walk-in", "Online", "Phone") and
  // any niche-specific reservation tier (e.g. "Standard", "VIP"). Free text
  // rather than an enum so it stays meaningful across niches.
  source          String?
  reservationType String?
  // Selected paid extras for this reservation, e.g.
  // [{ "label": "Birthday Celebration", "price": 15000 }]. Priced generically
  // like Product.attributes -- a small, per-booking list rather than a full
  // catalog relation, since these are usually one-off add-ons.
  addons          Json?
  // Reminder lead time in minutes before scheduledAt (null = no reminder),
  // and whether a booking-confirmation message goes out to the guest.
  reminderOffsetMinutes Int?
  sendConfirmation      Boolean         @default(true)

  // Guest contact used for payment-confirmation emails when there's no
  // BizNest customer account attached (see guestName/guestPhone above).
  guestEmail  String?

  // Short human-friendly code (7 alphanumeric characters) sent to the guest
  // after payment and entered by staff to verify the reservation. Null for
  // bookings made before codes existed -- those keep using their original
  // id, so older confirmations stay valid. See lib/booking-reference.ts.
  referenceCode String? @unique

  // Wallet payment tracking (see lib/actions/customer-wallet.ts).
  paymentStatus    BookingPaymentStatus @default(UNPAID)
  paymentReference String?              @unique
  paymentAmount    Decimal?             @db.Decimal(12, 2)
  paymentCurrency  String               @default("NGN")

  payments             Payment[]
  walletTransactions    WalletTransaction[]
  walletPaymentRequests WalletPaymentRequest[]

  @@index([serviceId, scheduledAt])
  @@index([storeId])
  @@index([unitId, checkIn, checkOut])
  @@index([staffId, scheduledAt])
  @@index([status, reviewRequestedAt])
}

enum BookingPaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
}

// ----------------------------------------------------------------------------
// ORDERS, PAYMENTS, ESCROW, DISPUTES
// ----------------------------------------------------------------------------

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  IN_PROGRESS
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

// FnB separates the commercial order lifecycle from production. Order.status
// remains the compatibility/financial lifecycle used across BizNest, while
// these fields describe what the restaurant is doing with the paid order.
enum FnbFulfillmentStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  FULFILLED
  CANCELLED
}

enum FnbKitchenStatus {
  QUEUED
  STARTED
  READY
  EXPO
  SERVED
  VOIDED
}

enum FnbOrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  KORAPAY
  // In-person sale settled outside any online gateway (cash, transfer, or a
  // card terminal the merchant runs themselves) -- see lib/actions/pos.ts.
  // The actual tender type is free text on Order.posTenderType since it
  // doesn't need a gateway integration, just a receipt record.
  CASH
  // A booking or funding operation settled from a customer's BizNest
  // store wallet balance rather than an external gateway charge.
  WALLET
}

enum OrderChannel {
  ONLINE
  // Rung up from the in-app POS (lib/actions/pos.ts) rather than the
  // storefront checkout -- same Order/OrderItem/Payment shape either way,
  // this just flags how the sale happened for the orders list and receipts.
  POS
}

enum PosTabStatus {
  OPEN
  SETTLED
}

// A running bill for one table (restaurants, bars, any dining). Every round of
// food/drinks rung up "to the table" is a normal POS Order linked here; the
// guest pays once at the end and the whole tab is settled in one go (or moved
// onto a checked-in guest's room folio). At most one OPEN tab per table label.
model PosTab {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  label         String
  status        PosTabStatus  @default(OPEN)
  customerName  String?
  openedAt      DateTime      @default(now())
  settledAt     DateTime?
  // How the tab was finally paid: Cash / Card / Transfer, or "Room charge (101)".
  settledTender String?
  settledByUserId String?
  orders        Order[]

  @@index([storeId, status])
}

// One row per time an owner/admin marks POS commission as settled (see
// Store.posCommissionOwed) -- append-only record of "we cleared ₦X of the
// balance on this date", same ledger pattern as StockMovement/
// StoreActivityLog. Doesn't represent a payment transfer itself (there's
// no gateway involved -- this is typically a bank transfer or cash handed
// over outside the app); it's just the paper trail for the running balance.
model PosCommissionSettlement {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  settledByEmail String

  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
}

// One row per refund that added to Store.refundClawbackOwed -- i.e. a
// refund where the merchant's split share had (or likely had, per the
// T+1-plus-buffer heuristic in lib/actions/refund.ts) already settled to
// their bank account, so the platform fronted that portion of the refund
// out of its own balance and now needs to recover it from the merchant.
// Distinct from PosCommissionSettlement: that ledger is money the merchant
// owes the platform as ordinary commission; this one is money the platform
// is owed back because it covered a merchant's refund obligation.
model StoreRefundClawback {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id])

  // The merchant's share of the refunded amount that the platform fronted
  // -- not the full refund (the platform's own commission share was never
  // the merchant's money to begin with, so only the merchant's cut needs
  // to be clawed back from them).
  amount      Decimal  @db.Decimal(12, 2)
  reason      String

  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([paymentId])
}

// One row per time an owner/admin (or an automated deduction from a future
// payout, once that exists) clears some/all of Store.refundClawbackOwed --
// same append-only ledger shape as PosCommissionSettlement.
model RefundClawbackSettlement {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  settledByEmail String

  createdAt   DateTime @default(now())

  @@index([storeId, createdAt])
}

// ----------------------------------------------------------------------------
// ABANDONED CHECKOUT RECOVERY -- deliberately not a separate "cart snapshot"
// table. startCheckout() already creates an Order row at PENDING_PAYMENT the
// moment a buyer begins checking out, with the full item list attached, so
// an "abandoned checkout" IS a PENDING_PAYMENT order that's gone stale (see
// ABANDONED_CHECKOUT_THRESHOLD_MINUTES in lib/constants/order.ts) rather than
// something we need to track separately. This table only records the
// merchant's outbound "you left something in your cart" nudges against that
// order -- one row per send attempt, same append-only ledger pattern as
// OrderStatusEvent/StockMovement, so a merchant can see what's already gone
// out before firing another channel at the same customer.
// ----------------------------------------------------------------------------

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  SENT
  FAILED
}

model AbandonedCheckoutNotification {
  id        String              @id @default(cuid())
  orderId   String
  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  status    NotificationStatus
  error     String?
  sentAt    DateTime            @default(now())

  @@index([orderId])
}

// ----------------------------------------------------------------------------
// WEBHOOKS (outbound) -- lets a store owner (or platform-level integration)
// register a URL and get real-time HTTP POSTs for things happening in their
// store, instead of polling the API. Two tables, same ledger pattern used
// elsewhere in this schema (StockMovement, OrderStatusEvent): WebhookEndpoint
// is the subscription itself, WebhookDelivery is an append-only record of
// every attempt made against it -- what makes retries, backoff, and the
// "delivery log" UI possible without re-deriving history from logs.
// ----------------------------------------------------------------------------

enum WebhookEventType {
  ORDER_CREATED
  ORDER_PAID
  ORDER_CANCELLED
  ORDER_FULFILLED

  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PAYMENT_REFUNDED

  BOOKING_CREATED
  BOOKING_CONFIRMED
  BOOKING_CANCELLED

  CUSTOMER_CREATED

  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_DELETED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCEEDED
  FAILED // exhausted retries
}

// A registered subscriber. storeId is null for platform-level endpoints
// (e.g. an internal integration listening across every store) -- store
// owners can only ever create/see endpoints scoped to their own store, an
// admin-only surface is what would create a storeId: null one.
model WebhookEndpoint {
  id          String   @id @default(cuid())
  storeId     String?
  store       Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)

  url         String
  description String?
  // Signing secret used to HMAC-SHA256 the raw request body -- sent back
  // to the subscriber only once, at creation/rotation time, same pattern
  // as an API key. Never rendered again after that.
  secret      String
  // Which of the WebhookEventType values this endpoint wants. Empty array
  // means "all events" so a first-time integrator doesn't have to know
  // every event name up front.
  events      WebhookEventType[]
  isActive    Boolean  @default(true)

  deliveries  WebhookDelivery[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([storeId])
}

// One row per delivery attempt-chain to a given endpoint for a given
// event. Re-attempts update the same row (attemptCount, lastAttemptAt,
// nextAttemptAt) rather than inserting a new one per try, so "has this
// event been delivered to this endpoint" stays a single lookup -- the
// per-try detail (status code, response snippet) is overwritten with the
// latest attempt's result, which is what a delivery-log UI wants to show.
model WebhookDelivery {
  id            String                @id @default(cuid())
  endpointId    String
  endpoint      WebhookEndpoint       @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  eventType     WebhookEventType
  // The exact JSON body sent (and re-sent on retry) -- kept so a retry
  // doesn't have to reconstruct the payload from current DB state, which
  // could have moved on since the event fired.
  payload       Json

  status        WebhookDeliveryStatus @default(PENDING)
  attemptCount  Int                   @default(0)
  lastStatusCode Int?
  // Truncated response body from the subscriber's endpoint, for debugging
  // failed deliveries from the dashboard without needing server logs.
  lastResponse  String?
  lastAttemptAt DateTime?
  // When the retry cron should next pick this row up. Null once the
  // delivery has SUCCEEDED or exhausted its retries (FAILED).
  nextAttemptAt DateTime?

  createdAt     DateTime              @default(now())

  @@index([endpointId])
  @@index([status, nextAttemptAt])
}


enum FnbShiftStatus {
  OPEN
  CLOSED
}

// One accountable register shift per FnB operator. Every POS sale is linked
// to the operator's open shift so sales can be reconciled by staff and by
// start/end time without changing the core Order model semantics.
model FnbShift {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  staffUserId String
  staffUser   User           @relation("FnbShiftStaff", fields: [staffUserId], references: [id], onDelete: Cascade)
  status      FnbShiftStatus @default(OPEN)
  startedAt   DateTime       @default(now())
  endedAt     DateTime?
  salesCount  Int            @default(0)
  salesTotal  Decimal        @db.Decimal(12, 2) @default(0)
  orders      Order[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([storeId, staffUserId, startedAt])
  @@index([storeId, status])
}

model Order {
  id            String        @id @default(cuid())
  storeId       String
  store         Store         @relation(fields: [storeId], references: [id])
  buyerId       String
  buyer         User          @relation("BuyerOrders", fields: [buyerId], references: [id])
  customerProfileId String?
  customerProfile   StoreCustomerProfile? @relation(fields: [customerProfileId], references: [id], onDelete: SetNull)

  status        OrderStatus   @default(PENDING_PAYMENT)
  fulfillmentStatus FnbFulfillmentStatus @default(NEW)
  kitchenStatus FnbKitchenStatus @default(QUEUED)
  subtotal      Decimal       @db.Decimal(12, 2)
  commission    Decimal       @db.Decimal(12, 2) @default(0)
  total         Decimal       @db.Decimal(12, 2)
  currency      String        @default("NGN")

  channel       OrderChannel  @default(ONLINE)
  fnbOrderType FnbOrderType?
  fnbTableLabel String?
  // Free-text tender description for POS sales only (e.g. "Cash", "Card",
  // "Transfer") -- paymentProvider stays CASH for all of these since none
  // of them go through an online gateway; this is just what prints on the
  // receipt. Null for ONLINE orders.
  posTenderType String?
  // Walk-in customer's name/phone, captured optionally at the POS register
  // when they aren't a registered buyer. buyerId still points at the
  // store's shared walk-in User (see getOrCreateWalkInCustomer) so Order's
  // required buyer relation doesn't need to change. Null for ONLINE orders.
  posCustomerName  String?
  posCustomerPhone String?

  paymentProvider PaymentProvider?
  paymentReference String?
  // Client-generated (see checkoutSchema/the *-checkout-client.tsx
  // components), one per checkout page load, reused unchanged across every
  // submit attempt including retries. Nullable+unique -- Postgres allows
  // multiple NULLs in a unique index, so every non-storefront-checkout
  // Order (POS, etc) simply leaves this null. This is the authoritative
  // dedupe key startCheckout looks up before ever creating a new order or
  // calling the gateway -- see the idempotency guard there.
  idempotencyKey   String? @unique
  // The gateway's own "pay now" page URL from the most recent charge
  // attempt on this order (Paystack authorization_url / Flutterwave
  // link). Cached so a duplicate checkout submission for the same
  // idempotencyKey can be handed the same payment page instead of
  // starting a second charge against the customer -- see the dedupe
  // check at the top of startCheckout in lib/actions/order.ts.
  checkoutUrl      String?
  // Manual bank-transfer orders: screenshot the customer uploaded as proof of
  // payment, when, and an optional note. Orders paid this way carry
  // paymentProvider CASH (settled outside the platform) and stay
  // PENDING_PAYMENT until the vendor confirms receipt.
  paymentProofUrl  String?
  paymentProofAt   DateTime?
  paymentProofNote String?
  escrowReleasedAt DateTime?

  deliveryZoneId String?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id])
  deliveryFee    Decimal       @db.Decimal(12, 2) @default(0)

  // Last-mile delivery tracking, set by the merchant (or a delivery-partner adapter, see lib/delivery).
  // deliveryStatus is one of lib/delivery DELIVERY_STATUSES; null until a delivery is recorded.
  deliveryProvider String?
  deliveryRef      String?
  deliveryStatus   String?
  trackingUrl      String?
  riderName        String?
  riderPhone       String?
  // Set once the automatic "how was it?" request has gone out, so it is never sent twice.
  reviewRequestedAt DateTime?

  items         OrderItem[]
  dispute       Dispute?
  conversation  Conversation?
  payments      Payment[]
  walletTransactions WalletTransaction[]

  // --- Loyalty / invoicing / quotations (additive) ---
  loyaltyEntries LoyaltyEntry[]
  storeLoyaltyEntries StoreLoyaltyEntry[]
  giftCardTransactions GiftCardTransaction[]
  referralReward Referral?     @relation("ReferralQualifyingOrder")
  invoice        Invoice?
  quote          Quote?

  shippingAddress Json?

  statusEvents  OrderStatusEvent[]
  stockMovements StockMovement[]
  fnbShift       FnbShift?       @relation(fields: [fnbShiftId], references: [id], onDelete: SetNull)
  fnbShiftId     String?

  // Running table bill: set when this POS order was added to an open table tab
  // instead of being paid on the spot. See PosTab.
  posTabId       String?
  posTab         PosTab?         @relation(fields: [posTabId], references: [id], onDelete: SetNull)

  // Recovery nudges sent while this order was stuck at PENDING_PAYMENT --
  // see AbandonedCheckoutNotification above.
  abandonedNotifications AbandonedCheckoutNotification[]
  // Set once the *merchant* (not the buyer) has been alerted that this
  // cart went stale, via app/api/cron/abandoned-checkout-alerts. Distinct
  // from abandonedNotifications, which tracks the buyer-facing recovery
  // messages the merchant sends out manually.
  merchantAlertedAt DateTime?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([storeId])
  @@index([storeId, kitchenStatus])
  @@index([buyerId])
  @@index([customerProfileId])
  @@index([posTabId])
  @@index([status, reviewRequestedAt])
}

// Append-only timeline of Order.status transitions -- this is what lets the
// dispute Resolution Center show real "delivery information" (when it was
// marked in progress/delivered/completed, and by what action) instead of
// just the single most-recent Order.updatedAt, which gets overwritten on
// every transition. Written from updateOrderStatus, issueRefund, and the
// dispute actions below -- never mutated after the fact, same ledger
// pattern as StockMovement.
model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?

  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  quantity  Int      @default(1)
  unitPrice Decimal  @db.Decimal(12, 2)
  // Pre-order snapshot: the line was sold as a pre-order (no stock consumed) with this expected ship date.
  preorder        Boolean   @default(false)
  preorderShipsOn DateTime? @db.Date
  // Snapshot of the kitchen station at order creation time.
  fnbStation String?
}

// One row per real charge attempt against a payment gateway -- the audit
// trail and reconciliation source of truth that used to live only as a
// couple of fields on Order. An order can have more than one Payment row
// over its life (a failed attempt followed by a successful retry); Order's
// own paymentProvider/paymentReference fields stay in place as a fast
// "what actually got it PAID" pointer, but this table is where every
// attempt -- successful or not -- gets recorded, along with the raw gateway
// payload for debugging and dispute evidence.
model Payment {
  id          String          @id @default(cuid())

  orderId     String?
  order       Order?          @relation(fields: [orderId], references: [id])
  // Subscription-upgrade payments aren't tied to an Order, only a Store --
  // set for both purposes so a store's full payment history (orders +
  // subscription upgrades) can be queried from one place.
  storeId     String?
  store       Store?          @relation(fields: [storeId], references: [id])

  // Wallet payments (see lib/actions/customer-wallet.ts): a booking paid
  // from a customer's store wallet, and the wallet the funds moved through.
  bookingId   String?
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  walletId    String?
  wallet      StoreWallet?    @relation(fields: [walletId], references: [id])
  // Back-relation for WalletTransaction.payment (one-to-one via
  // WalletTransaction.paymentId being @unique).
  walletTransaction WalletTransaction?

  // A PMS reservation deposit/stay charge (see lib/actions/pms.ts) --
  // same pattern as bookingId above, just for PropertyReservation instead
  // of the service-booking Booking model.
  reservationId String?
  reservation   PropertyReservation? @relation(fields: [reservationId], references: [id])

  // A BizNest Travel deposit/balance payment (see lib/payments/settle-travel.ts).
  travelTripId  String?
  travelTrip    TravelTrip? @relation(fields: [travelTripId], references: [id], onDelete: SetNull)

  // A tailoring job balance paid online from the customer's status page (see lib/payments/settle-tailoring.ts).
  tailoringJobId String?
  tailoringJob   TailoringJob? @relation(fields: [tailoringJobId], references: [id], onDelete: SetNull)

  // A tenant paying a rent charge online from their portal link (see lib/payments/settle-rent.ts).
  rentChargeId   String?
  rentCharge     RentCharge?   @relation(fields: [rentChargeId], references: [id], onDelete: SetNull)

  // A member paying dues, a package or a gift (see lib/payments/settle-member.ts).
  memberChargeId String?
  memberCharge   MemberCharge? @relation(fields: [memberChargeId], references: [id], onDelete: SetNull)

  // Someone buying event tickets (see lib/payments/settle-ticket.ts).
  ticketOrderId  String?
  ticketOrder    TicketOrder? @relation(fields: [ticketOrderId], references: [id], onDelete: SetNull)

  // A customer paying a job-card charge (see lib/payments/settle-job.ts).
  jobChargeId    String?
  jobCharge      JobCharge? @relation(fields: [jobChargeId], references: [id], onDelete: SetNull)

  purpose     PaymentPurpose
  provider    PaymentProvider
  // The value passed to the gateway as reference/tx_ref, and the value both
  // the callback route and the webhook look this row up by. Unique because
  // each charge attempt gets its own reference (order checkout: the order's
  // id; subscription upgrade: the SUBUP-... string built in
  // lib/actions/subscription.ts).
  reference   String          @unique
  status      PaymentStatus   @default(PENDING)
  amount      Decimal         @db.Decimal(12, 2)
  currency    String          @default("NGN")

  // Full verify-endpoint response body from whichever route last touched
  // this row (browser callback or webhook) -- kept for debugging and as
  // evidence if a dispute/chargeback needs to be investigated later.
  rawPayload  Json?
  // Set the first time server-side verification against the gateway
  // succeeds -- null while still PENDING.
  verifiedAt  DateTime?

  // The subaccount code/id this charge was actually split to at
  // initialize-time (store.paystackSubaccountCode or
  // flutterwaveSubaccountId, whichever provider was used) -- null if this
  // charge wasn't split (no payout account connected yet, or a purpose
  // that never splits, e.g. subscription billing). Recorded per-payment
  // rather than inferred from the store's *current* subaccount, since a
  // store can disconnect/reconnect payouts and the store's live value at
  // refund time may not match what a much older charge actually used.
  // See recordRefundClawbackIfSettled in lib/actions/refund.ts.
  splitSubaccountCode String?

  // True when this charge was made with the store's OWN gateway keys (see
  // Store.ownGatewayEnabled). Verification, webhooks and refunds must then
  // use the store's keys, and no vendor payout is created for it.
  usesStoreGateway Boolean @default(false)

  // Bank-transfer payments (provider CASH) for invoices, quote deposits,
  // service bookings and PMS deposits: the customer's screenshot of the
  // transfer, kept here because those purposes have no Order row to hold it.
  // (Order checkout keeps its proof on Order.paymentProofUrl.)
  proofUrl    String?
  proofAt     DateTime?
  proofNote   String?

  // Refund tracking, set when a support/admin agent issues a refund
  // against this charge (see lib/actions/refund.ts). refundReference is
  // the gateway's own refund id -- unique so the same charge can't somehow
  // collect two successful refund rows. refundedAmount lets a future
  // partial-refund flow reuse this same table without a schema change.
  refundReference   String?   @unique
  refundedAmount    Decimal?  @db.Decimal(12, 2)
  refundReason      String?
  refundedByEmail   String?
  refundedAt        DateTime?

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // --- Invoicing / quotations (additive) ---
  invoice     Invoice?
  quoteDepositFor Quote?

  // Set if this refund triggered a merchant-share clawback (see
  // StoreRefundClawback) because the split had already settled.
  refundClawbacks StoreRefundClawback[]

  // The vendor payout (Transfer API) created for this charge, if any.
  payout Payout?

  @@index([orderId])
  @@index([storeId])
  @@index([status])
  @@index([bookingId])
  @@index([walletId])
  @@index([reservationId])
  @@index([travelTripId])
  @@index([rentChargeId])
  @@index([memberChargeId])
  @@index([ticketOrderId])
  @@index([jobChargeId])
  @@index([tailoringJobId])
}

// Money owed to a vendor for one successful customer payment, paid out with
// the gateway Transfer API (no subaccount, no split). One row per Payment
// (paymentId is unique), so a payment can never be paid out twice.
//
// Lifecycle: QUEUED -> PROCESSING (transfer accepted by gateway) -> PAID, or
// FAILED (retryable, see attempts/nextAttemptAt) / REVERSED (gateway sent the
// money back after accepting it). `reference` is the idempotency key sent to
// the gateway; it is derived from this row's id and never regenerated.
model Payout {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  paymentId   String         @unique
  payment     Payment        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  provider    PaymentProvider
  status      PayoutStatus   @default(QUEUED)
  // What the vendor is sent: the payment minus the gateway fee (feeAmount).
  amount      Decimal        @db.Decimal(12, 2)
  // Gateway fee held back from the vendor (collection fee + flat transfer fee).
  feeAmount   Decimal        @default(0) @db.Decimal(12, 2)
  currency    String         @default("NGN")

  reference         String   @unique
  // Paystack transfer_code / Flutterwave numeric transfer id.
  gatewayTransferId String?
  // Where the money was sent, captured at send time (store can change bank later).
  destination       Json?

  attempts      Int          @default(0)
  lastError     String?
  nextAttemptAt DateTime?
  paidAt        DateTime?
  rawPayload    Json?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([storeId, createdAt])
  @@index([status, nextAttemptAt])
}

enum PayoutStatus {
  // Held in the platform wallet until SupaAdmin releases it (payout mode HOLD).
  HELD
  QUEUED
  PROCESSING
  PAID
  FAILED
  REVERSED
}

enum PaymentPurpose {
  ORDER
  SUBSCRIPTION_UPGRADE
  SUBSCRIPTION_RENEWAL
  INVOICE
  QUOTE_DEPOSIT
  SERVICE_BOOKING
  WALLET_FUNDING
  PMS_RESERVATION
  PLUGIN_PURCHASE
  TRAVEL_BOOKING
  TAILORING_BALANCE
  RENT_PAYMENT
  MEMBER_PAYMENT
  TICKET_PURCHASE
  JOB_PAYMENT
  AD_CAMPAIGN
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  REFUND_PENDING
  FAILED
  REFUNDED
}

// A per-customer, per-store balance customers can fund via gateway and
// spend on bookings (see lib/actions/customer-wallet.ts). Scoped to a
// single store, matching BizNest's store-scoped customer architecture.
model StoreWallet {
  id        String            @id @default(cuid())
  storeId   String
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  currency  String            @default("NGN")
  balance   Decimal           @db.Decimal(12, 2) @default(0)
  status    WalletStatus      @default(ACTIVE)

  payments             Payment[]
  transactions         WalletTransaction[]
  paymentRequests      WalletPaymentRequest[]

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([storeId, userId])
  @@index([userId])
  @@index([storeId, status])
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

// One row per balance-affecting movement on a wallet -- the ledger a
// customer's wallet page reads from (see getWallet in
// lib/actions/customer-wallet.ts).
model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  wallet       StoreWallet           @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type         WalletTransactionType
  amount       Decimal               @db.Decimal(12, 2)
  balanceAfter Decimal               @db.Decimal(12, 2)
  reference    String                @unique

  paymentId    String?               @unique
  payment      Payment?              @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  bookingId    String?
  booking      Booking?              @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  orderId      String?
  order        Order?                @relation(fields: [orderId], references: [id], onDelete: SetNull)

  note         String?
  createdAt    DateTime              @default(now())

  @@index([walletId, createdAt])
  @@index([bookingId])
  @@index([orderId])
}

enum WalletTransactionType {
  FUNDING
  PAYMENT
  REFUND
  ADJUSTMENT
}

// A short-lived QR/link token a merchant can present to a customer to
// collect a wallet payment for a booking in person (see
// createWalletPaymentRequest / redeemWalletPaymentRequest).
model WalletPaymentRequest {
  id         String                     @id @default(cuid())
  storeId    String
  store      Store                      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  walletId   String
  wallet     StoreWallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  bookingId  String
  booking    Booking                    @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  tokenHash  String                     @unique
  amount     Decimal                    @db.Decimal(12, 2)
  currency   String                     @default("NGN")
  status     WalletPaymentRequestStatus @default(PENDING)
  expiresAt  DateTime
  redeemedAt DateTime?
  createdAt  DateTime                   @default(now())

  @@index([storeId, status])
  @@index([bookingId, status])
  @@index([walletId])
  @@index([expiresAt])
}

enum WalletPaymentRequestStatus {
  PENDING
  REDEEMED
  CANCELLED
  EXPIRED
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED_BUYER
  RESOLVED_SELLER
  CLOSED
}

// The BizNest Resolution Center. One Dispute per Order (a buyer or seller
// opens it, e.g. "I didn't receive my order" vs "Order was delivered"),
// with a full paper trail an admin can review before deciding: evidence
// (DisputeEvidence -- photos/files/notes from either side), the order's
// Conversation/Message thread (reused as-is, keyed off the same orderId),
// delivery info (Order.shippingAddress/deliveryZone + OrderStatusEvent
// timeline), and payment info (Order.payments). The admin decision itself
// is just adminNotes + status -- RESOLVED_BUYER/RESOLVED_SELLER/CLOSED --
// there's no separate "outcome" enum because the status already encodes it.
model Dispute {
  id            String        @id @default(cuid())
  orderId       String        @unique
  order         Order         @relation(fields: [orderId], references: [id])
  raisedById    String
  raisedBy      User          @relation("DisputeRaisedBy", fields: [raisedById], references: [id])

  reason        String        @db.Text
  status        DisputeStatus @default(OPEN)
  evidence      DisputeEvidence[]

  adminNotes    String?       @db.Text
  // Mirrors Business.reviewedByAdminId -- the shared-PIN /supaadmin panel
  // has no per-person identity, so this is null unless a future per-admin
  // login replaces the PIN (see lib/admin-pin-auth.ts).
  resolvedByAdminId String?

  createdAt     DateTime      @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

// One row per piece of evidence a buyer or seller submits to a dispute --
// a photo (fileUrl), a document (fileUrl), or a plain note. Kept as its own
// append-only table rather than a flat string[] so the Resolution Center
// can show who submitted what and when, the same trail an admin needs to
// actually adjudicate "I didn't receive it" vs "it was delivered".
model DisputeEvidence {
  id            String   @id @default(cuid())
  disputeId     String
  dispute       Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id])

  fileUrl       String?
  note          String?  @db.Text

  createdAt     DateTime @default(now())

  @@index([disputeId])
}

// Local delivery pricing for physical-goods stores (food, groceries, etc.).
// A store with no zones defined is treated as "delivery not offered yet" --
// checkout falls back to pickup/no shipping fee rather than blocking sale.
// Lightweight page-view log, purely to power the "Visitors" / "Conversion"
// numbers on the seller dashboard (see lib/actions/analytics.ts). One row
// per storefront page load — deliberately minimal (no user/session
// tracking, no cross-store identity) since its only job is a daily count,
// not a full analytics product. Only written from real buyer-facing pages
// (storefront home, category, product) — never from admin/dashboard pages,
// so a seller browsing their own store doesn't inflate their own numbers.
model StoreVisit {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  path      String
  // Raw HTTP Referer header captured at visit time (see recordStoreVisit in
  // lib/actions/analytics.ts). Null for direct visits and for rows that
  // predate this column. Bucketed into source categories at read time.
  referrer  String?
  createdAt DateTime @default(now())

  @@index([storeId, createdAt])
}

model DeliveryZone {
  id               String   @id @default(cuid())
  storeId          String
  store            Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  city             String?  // optional grouping, e.g. "Abuja" — zones with no city render ungrouped
  name             String   // e.g. "Wuse & Garki", "Lekki Phase 1"
  fee              Decimal  @db.Decimal(12, 2)
  estimatedMinutes Int?
  isActive         Boolean  @default(true)

  orders           Order[]

  createdAt        DateTime @default(now())

  @@index([storeId])
  @@index([storeId, city])
}

// Newsletter signups collected from a store's storefront (opt-in "Newsletter"
// section -- see lib/template-themes.ts Section type). Real capture, not
// decorative -- a vendor can export/see these, distinct from platform users.
model NewsletterSubscriber {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  email     String
  createdAt DateTime @default(now())
  unsubscribedAt DateTime?

  @@unique([storeId, email])
  @@index([storeId])
}

enum EmailCampaignStatus {
  DRAFT
  SENDING
  SENT
  PARTIAL
  FAILED
}

model EmailCampaign {
  id             String             @id @default(cuid())
  storeId        String
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  subject        String
  template       String
  previewText    String?
  content        Json
  status         EmailCampaignStatus @default(DRAFT)
  recipientCount Int                @default(0)
  sentCount      Int                @default(0)
  failedCount    Int                @default(0)
  sentAt         DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([storeId, createdAt])
  @@index([storeId, status])
}

model Coupon {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  code        String
  discountType String  // "PERCENT" | "FIXED"
  discountValue Decimal @db.Decimal(12, 2)
  maxUses     Int?
  usedCount   Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)

  @@unique([storeId, code])
}

// ----------------------------------------------------------------------------
// REVIEWS
// ----------------------------------------------------------------------------

model Review {
  id         String   @id @default(cuid())
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id])
  serviceId  String?
  service    Service? @relation(fields: [serviceId], references: [id])
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])

  rating     Int      // 1-5
  comment    String?  @db.Text
  images     String[]
  videos     String[]

  response   ReviewResponse?
  report     ReviewReport?

  createdAt  DateTime @default(now())
}

model ReviewResponse {
  id        String   @id @default(cuid())
  reviewId  String   @unique
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String   @db.Text
  createdAt DateTime @default(now())
}

enum ReviewReportStatus {
  OPEN
  UPHELD
  DISMISSED
}

// A merchant's report of a review that breaks the rules (abusive, spam, fake,
// off-topic, private info). One report per review: BizNest staff decide it in
// /supaadmin/review-reports. UPHELD removes the review; DISMISSED keeps it.
// reviewId is SetNull + the snapshot columns so the record (and what was
// decided) survives the review being deleted after an upheld report.
model ReviewReport {
  id               String             @id @default(cuid())
  storeId          String
  store            Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  reviewId         String?            @unique
  review           Review?            @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  reportedById     String
  reportedBy       User               @relation("ReviewReportedBy", fields: [reportedById], references: [id])

  reason           String
  details          String?            @db.Text
  status           ReviewReportStatus @default(OPEN)
  adminNotes       String?            @db.Text
  resolvedAt       DateTime?

  reviewRating     Int
  reviewComment    String?            @db.Text
  reviewAuthorName String?

  createdAt        DateTime           @default(now())

  @@index([status, createdAt])
  @@index([storeId])
}

// ----------------------------------------------------------------------------
// MESSAGING
// ----------------------------------------------------------------------------

model Conversation {
  id        String   @id @default(cuid())
  storeId   String?
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderId   String?  @unique
  order     Order?   @relation(fields: [orderId], references: [id])

  participants ConversationParticipant[]
  messages     Message[]

  createdAt DateTime @default(now())

  @@index([storeId])
}

model ConversationParticipant {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])

  content        String       @db.Text
  attachmentUrls String[]
  readAt         DateTime?

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([conversationId, readAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String   // "ORDER_UPDATE" | "MESSAGE" | "VERIFICATION" | ...
  title     String
  body      String
  url       String?  // where tapping the notification (in-app or push) should take the merchant
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

// ----------------------------------------------------------------------------
// PUSH NOTIFICATIONS -- Web Push (VAPID), not FCM/APNs directly. A merchant's
// browser (mobile Chrome on Android is the primary target -- see
// lib/push/send.ts) registers a subscription per device via the service
// worker in public/sw.js. One user can have several rows here (phone +
// laptop both subscribed); a dead/expired one is pruned automatically the
// next time a send to it 404s/410s rather than needing a cleanup job.
// ----------------------------------------------------------------------------
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ----------------------------------------------------------------------------
// SUBSCRIPTIONS / PLATFORM SETTINGS / AUDIT
// ----------------------------------------------------------------------------

model Subscription {
  id        String   @id @default(cuid())
  name      String   @unique // "Free" | "Entrepreneur" | "Enterprise" | "Business Mogul"
  price     Decimal  @db.Decimal(12, 2)
  interval  String   // "MONTHLY" | "YEARLY"
  features  Json     // { products, services, customDomain } -- -1 means unlimited
  commissionRate Decimal @db.Decimal(5, 2) @default(0) // percentage
  isActive  Boolean  @default(true) // retired plans are hidden from pricing/upgrade UI, not deleted -- a store may still reference one
  // BizNest Marketing (see lib/access/marketing-tool.ts) is a fully separate
  // product from the main storefront platform with its own two-tier pricing
  // (Starter/Pro, seeded in prisma/migrations/20260921100000_marketing_plans).
  // This flag keeps those two plans out of every main-platform plan list
  // (landing page pricing, onboarding/select-plan, a store's own subscription
  // page) and out of the marketing plan picker's opposite number -- both
  // sides filter on it. It does NOT gate the free-trial setting: that stays
  // one platform-wide planId (any plan, either product) picked by SupaAdmin
  // at /supaadmin/settings, same mechanism either way.
  isMarketingPlan Boolean @default(false)

  stores    Store[]
  pluginAccess PluginPlanAccess[]
}

// ----------------------------------------------------------------------------
// APP MARKETPLACE / PLUGINS
//
// Plugins are platform-managed applications. SupaAdmin controls pricing,
// activation and which subscription plans may use each app. Store access is
// recorded separately so an app can be installed/disabled without changing
// the store's core subscription.
// ----------------------------------------------------------------------------

enum PluginStatus {
  ACTIVE
  DISABLED
}

enum PluginBillingInterval {
  MONTHLY
  YEARLY
  ONE_TIME
}

enum StorePluginStatus {
  ACTIVE
  SUSPENDED
}

model Plugin {
  id                  String               @id @default(cuid())
  key                 String               @unique
  name                String
  description         String               @db.Text
  category            String
  icon                String?
  price               Decimal              @db.Decimal(12, 2) @default(0)
  currency            String               @default("NGN")
  billingInterval     PluginBillingInterval @default(MONTHLY)
  isFree              Boolean              @default(false)
  isComingSoon        Boolean              @default(false)
  status              PluginStatus         @default(ACTIVE)
  eligibleBusinessTypes Json?
  sortOrder           Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  planAccess          PluginPlanAccess[]
  stores              StorePlugin[]

  @@index([status, sortOrder])
  @@index([category])
}

model PluginPlanAccess {
  id             String       @id @default(cuid())
  pluginId       String
  plugin         Plugin       @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@unique([pluginId, subscriptionId])
  @@index([subscriptionId])
}

model StorePlugin {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pluginId    String
  plugin      Plugin           @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  status      StorePluginStatus @default(ACTIVE)
  installedAt DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  renewsAt    DateTime?
  pastDueSince DateTime?
  lastPaymentAt DateTime?

  @@unique([storeId, pluginId])
  @@index([storeId, status])
}

// ----------------------------------------------------------------------------
// CHURN WATCH
// One row per (store, warning sign) while that sign is active. The daily
// churn-watch cron opens a row the first time a sign appears (and nudges the
// owner once), refreshes lastDetectedAt while it persists, and sets
// resolvedAt when it clears -- so a store that goes quiet, recovers, and goes
// quiet again is nudged again, but never twice for the same quiet spell.
// ----------------------------------------------------------------------------
enum ChurnSignalKind {
  NO_LOGIN
  NO_ORDERS
  PAYMENT_FAILED
  UNUSED_PLUGIN
}

model ChurnSignal {
  id              String          @id @default(cuid())
  storeId         String
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  kind            ChurnSignalKind
  // Sub-key for kinds that can fire more than once per store (UNUSED_PLUGIN
  // uses the plugin key). Empty string otherwise -- not null, so the unique
  // index below actually dedupes.
  subject         String          @default("")
  detail          String?
  firstDetectedAt DateTime        @default(now())
  lastDetectedAt  DateTime        @default(now())
  notifiedAt      DateTime?
  // Owner hid the dashboard tip. Does not resolve the signal.
  dismissedAt     DateTime?
  resolvedAt      DateTime?

  // At most one OPEN row per (storeId, kind, subject) is enforced by a partial
  // unique index added in raw SQL (prisma/migrations/20261031090000_churn_signals);
  // Prisma's schema DSL can't express a WHERE-scoped unique index.
  @@index([storeId, resolvedAt])
  @@index([resolvedAt, kind])
}


// ----------------------------------------------------------------------------
// REQUISITIONS
// Internal requests for stock, supplies, equipment or services. Requisitions
// are intentionally separate from purchase orders: a team can request first,
// receive approval, and only then convert the approved request into purchasing.
// ----------------------------------------------------------------------------
enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum RequisitionPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Requisition {
  id             String              @id @default(cuid())
  number         String              @unique
  storeId        String
  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title          String
  department     String?
  requesterName  String?
  priority       RequisitionPriority @default(NORMAL)
  status         RequisitionStatus   @default(DRAFT)
  neededBy      DateTime?
  notes          String?             @db.Text
  decisionNote   String?             @db.Text
  submittedAt    DateTime?
  decidedAt      DateTime?
  convertedAt    DateTime?
  items          RequisitionItem[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([storeId, status])
  @@index([storeId, priority])
  @@index([storeId, neededBy])
  @@index([storeId, createdAt])
}

model RequisitionItem {
  id                 String        @id @default(cuid())
  requisitionId      String
  requisition        Requisition   @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId          String?
  variant            ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  description        String
  quantity           Int
  unit               String?
  estimatedUnitCost  Decimal?      @db.Decimal(12, 2)
  note               String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([requisitionId])
  @@index([productId])
  @@index([variantId])
}

// ----------------------------------------------------------------------------
// FINANCIAL CONTROL
// ----------------------------------------------------------------------------

enum FinancialAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum FinancialEntryStatus {
  DRAFT
  POSTED
  VOIDED
}

enum FinancialPeriodStatus {
  OPEN
  CLOSED
}

enum FinancialExpenseStatus {
  DRAFT
  APPROVED
  POSTED
  REJECTED
}

model FinancialAccount {
  id        String               @id @default(cuid())
  storeId   String
  store     Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  code      String
  name      String
  type      FinancialAccountType
  parentId  String?
  parent    FinancialAccount?    @relation("FinancialAccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  FinancialAccount[]   @relation("FinancialAccountTree")
  isSystem  Boolean              @default(false)
  isActive  Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  journalLines FinancialJournalLine[]
  expenses    FinancialExpense[] @relation("ExpenseCategoryAccount")
  paymentExpenses FinancialExpense[] @relation("ExpensePaymentAccount")
  bankAccounts FinancialBankAccount[]
  cityLedgerAccount FinancialCityLedgerAccount?
  budgetLines FinancialBudgetLine[]

  @@unique([storeId, code])
  @@index([storeId, type, isActive])
}

model FinancialPeriod {
  id        String                 @id @default(cuid())
  storeId   String
  store     Store                  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    FinancialPeriodStatus   @default(OPEN)
  closedAt  DateTime?
  closedBy  String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  entries FinancialJournalEntry[]

  @@unique([storeId, startsAt, endsAt])
  @@index([storeId, status])
}

model FinancialJournalEntry {
  id          String               @id @default(cuid())
  storeId     String
  store       Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  periodId    String?
  period      FinancialPeriod?     @relation(fields: [periodId], references: [id], onDelete: SetNull)
  reference   String
  description String               @db.Text
  entryDate   DateTime
  status      FinancialEntryStatus @default(DRAFT)
  postedAt    DateTime?
  postedBy    String?
  createdBy   String?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  lines       FinancialJournalLine[]
  expense     FinancialExpense?

  @@unique([storeId, reference])
  @@index([storeId, entryDate])
  @@index([storeId, status])
}

model FinancialJournalLine {
  id              String               @id @default(cuid())
  journalEntryId  String
  journalEntry    FinancialJournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId       String
  account         FinancialAccount     @relation(fields: [accountId], references: [id])
  description     String?
  debit           Decimal              @db.Decimal(12, 2) @default(0)
  credit          Decimal              @db.Decimal(12, 2) @default(0)

  @@index([journalEntryId])
  @@index([accountId])
}

// City ledger: a receivable account for a company/guest billed on credit
// (hotel-style "bill to account"). Each one is backed by its own child ASSET
// account under Accounts Receivable (1100), so charges and payments are posted
// through the normal journal and the balance always comes from the ledger.
model FinancialCityLedgerAccount {
  id                 String           @id @default(cuid())
  storeId            String
  store              Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  financialAccountId String           @unique
  financialAccount   FinancialAccount @relation(fields: [financialAccountId], references: [id])
  accountNo          String
  name               String
  contactName        String?
  email              String?
  phone              String?
  creditLimit        Decimal?         @db.Decimal(12, 2)
  paymentTermsDays   Int              @default(30)
  notes              String?          @db.Text
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([storeId, accountNo])
  @@unique([storeId, name])
  @@index([storeId, isActive])
}

model FinancialBankAccount {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  financialAccountId String
  financialAccount FinancialAccount @relation(fields: [financialAccountId], references: [id])
  name          String
  bankName      String?
  accountName   String?
  maskedNumber  String?
  openingBalance Decimal @db.Decimal(12, 2) @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  transactions  FinancialBankTransaction[]

  @@unique([storeId, name])
  @@index([storeId, isActive])
}

enum FinancialBankTransactionStatus {
  UNMATCHED
  MATCHED
  IGNORED
}

model FinancialBankTransaction {
  id            String   @id @default(cuid())
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  bankAccountId String
  bankAccount   FinancialBankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  transactionDate DateTime
  description   String   @db.Text
  reference     String?
  amount        Decimal  @db.Decimal(12, 2)
  status        FinancialBankTransactionStatus @default(UNMATCHED)
  matchedJournalEntryId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([storeId, transactionDate])
  @@index([bankAccountId, status])
}

enum FinancialBudgetStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model FinancialBudget {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  startsAt  DateTime
  endsAt    DateTime
  status    FinancialBudgetStatus @default(DRAFT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lines     FinancialBudgetLine[]

  @@unique([storeId, name])
  @@index([storeId, status])
}

model FinancialBudgetLine {
  id        String   @id @default(cuid())
  budgetId  String
  budget    FinancialBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  accountId String
  account   FinancialAccount @relation(fields: [accountId], references: [id])
  amount    Decimal  @db.Decimal(12, 2)

  @@unique([budgetId, accountId])
  @@index([accountId])
}

model FinancialAsset {
  id                String   @id @default(cuid())
  storeId           String
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  assetNo           String
  name              String
  category          String
  purchaseDate      DateTime
  purchaseCost      Decimal  @db.Decimal(12, 2)
  usefulLifeMonths  Int
  residualValue     Decimal  @db.Decimal(12, 2) @default(0)
  depreciationMethod String  @default("STRAIGHT_LINE")
  accumulatedDepreciation Decimal @db.Decimal(12, 2) @default(0)
  status            String   @default("ACTIVE")
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([storeId, assetNo])
  @@index([storeId, status])
}

model FinancialExpense {
  id              String                  @id @default(cuid())
  storeId         String
  store           Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  expenseNo       String
  description     String                  @db.Text
  vendorName      String?
  amount          Decimal                 @db.Decimal(12, 2)
  currency        String                  @default("NGN")
  expenseDate     DateTime
  expenseAccountId String
  expenseAccount  FinancialAccount       @relation("ExpenseCategoryAccount", fields: [expenseAccountId], references: [id])
  paymentAccountId String
  paymentAccount  FinancialAccount       @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id])
  status          FinancialExpenseStatus  @default(DRAFT)
  notes           String?                 @db.Text
  journalEntryId  String?                 @unique
  journalEntry    FinancialJournalEntry?  @relation(fields: [journalEntryId], references: [id], onDelete: SetNull)
  createdBy       String?
  approvedBy      String?
  approvedAt      DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([storeId, expenseNo])
  @@index([storeId, expenseDate])
  @@index([storeId, status])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}


// ----------------------------------------------------------------------------
// BIZNEST AUTOMATIONS
// Generic, store-scoped trigger/condition/action workflows. JSON keeps the
// engine extensible while the action executor validates every operation.
// ----------------------------------------------------------------------------
enum AutomationStatus {
  ACTIVE
  PAUSED
}

model Automation {
  id          String           @id @default(cuid())
  storeId     String
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  trigger     String
  conditions  Json?
  actions     Json
  status      AutomationStatus @default(ACTIVE)
  createdById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  runs        AutomationRun[]
  @@index([storeId, status])
  @@index([storeId, trigger])
}

model AutomationRun {
  id           String     @id @default(cuid())
  storeId      String
  store        Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  status       String
  event        Json?
  result       Json?
  error        String?
  startedAt    DateTime   @default(now())
  finishedAt   DateTime?
  @@index([storeId, startedAt])
  @@index([automationId, startedAt])
}

// ----------------------------------------------------------------------------
// DOCUMENTS / APPROVALS / REPORT BUILDER
// ----------------------------------------------------------------------------
model BusinessDocument {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title       String
  documentType String
  fileUrl     String
  entityType  String?
  entityId    String?
  expiresAt   DateTime?
  metadata    Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([storeId, documentType])
  @@index([storeId, entityType, entityId])
  @@index([storeId, expiresAt])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ApprovalRequest {
  id           String         @id @default(cuid())
  storeId      String
  store        Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title        String
  requestType  String
  entityType   String?
  entityId     String?
  requestedById String?
  approverId   String?
  status       ApprovalStatus @default(PENDING)
  note         String?
  metadata     Json?
  createdAt    DateTime       @default(now())
  decidedAt    DateTime?
  @@index([storeId, status, createdAt])
  @@index([storeId, entityType, entityId])
}

model ReportDefinition {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  description String?
  source      String
  fields      Json
  filters     Json?
  groupBy     Json?
  schedule    String?
  recipients  Json?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([storeId, name])
  @@index([storeId, source])
}

// ----------------------------------------------------------------------------
// VERTICAL WORKFLOW RECORDS. These complement core Products/Customers/
// Orders/Invoices/Bookings instead of duplicating them.
// ----------------------------------------------------------------------------
model RealEstateProperty {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name        String
  propertyType String
  address     String?
  status      String   @default("AVAILABLE")
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  units       RealEstateUnit[]
  @@index([storeId, status])
}
model RealEstateUnit {
  id          String   @id @default(cuid())
  propertyId  String
  property    RealEstateProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unitNo      String
  status      String   @default("VACANT")
  rentAmount  Decimal? @db.Decimal(12,2)
  tenantName  String?
  tenantEmail String?
  tenantPhone String?
  // MONTHLY | QUARTERLY | BIANNUAL | ANNUAL. Nigerian leases are commonly annual.
  rentCycle   String   @default("ANNUAL")
  // Secret link the tenant uses to see charges, pay rent and report faults. Null until the unit has a tenant.
  portalToken String?  @unique
  leaseStart  DateTime?
  leaseEnd    DateTime?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  rentCharges RentCharge[]
  maintenanceRequests MaintenanceRequest[]
  @@unique([propertyId, unitNo])
  @@index([propertyId, status])
}

model AutoVehicle {
