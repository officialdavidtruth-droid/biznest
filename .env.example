# --- App ---
NEXT_PUBLIC_APP_URL=https://biznest.vercel.app

# --- Database (Vercel Postgres / Neon / Supabase, etc.) ---
DATABASE_URL=postgresql://user:password@host:5432/biznest

# --- Auth.js ---
AUTH_SECRET=          # generate with: npx auth secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Cloudinary (file uploads: KYC docs, product images, store logos) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (each seller connects their own; these are platform-level app credentials) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="BizNest <no-reply@biznest.app>"

# --- AI features (phase 5) ---
OPENAI_API_KEY=
