# --- App ---
NEXT_PUBLIC_APP_URL=https://www.biznest.space

# --- Database (Supabase) ---
# DATABASE_URL: the pooled connection (port 6543, via PgBouncer) — used by the app at runtime.
# DIRECT_URL: the direct connection (port 5432) — used only for running migrations.
# Both come from Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Auth.js ---
AUTH_SECRET=          # generate with: npx auth secret
# Set to your real production URL once on a custom domain (biznest.space) —
# Auth.js validates the request host against this. Omit for localhost dev.
AUTH_URL=https://www.biznest.space
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Platform admin panel (/supaadmin) ---
# Single shared PIN, completely separate from the user/NextAuth system above
# — there's no per-person login here, just this one PIN. Pick any string.
ADMIN_PIN=
# Used to sign the admin session cookie (NOT the PIN itself). Generate with:
# openssl rand -hex 32
ADMIN_PIN_SECRET=

# --- Cloudinary (file uploads: KYC docs, product images, store logos) ---
# AI Store Builder — powers "Tell us about your business" onboarding
# generation on the Custom AI-Built Store plan. Get a key from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments (each seller connects their own; these are platform-level app credentials) ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Static secret hash you set in the Flutterwave dashboard under
# Settings -> Webhooks — Flutterwave echoes it back on every webhook call
# via the verif-hash header so we can confirm the request is really theirs.
FLUTTERWAVE_SECRET_HASH=
# Webhook URLs to configure on each provider's dashboard, once deployed:
#   Paystack:     https://<yourdomain>/api/payments/paystack/webhook
#   Flutterwave:  https://<yourdomain>/api/payments/flutterwave/webhook
# Paystack signs its webhook body with your PAYSTACK_SECRET_KEY automatically
# (no separate hash to configure) — just point the dashboard at the URL above.

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="BizNest <no-reply@biznest.space>"

# --- Web Push (VAPID) — order/abandoned-checkout alerts to merchant devices ---
# Generate with: npx web-push generate-vapid-keys
# Public key is exposed to the browser on purpose (that's how Web Push works —
# it's not a secret, it just identifies this deployment to the push service).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:support@biznest.space"

# --- Cron auth (Vercel Cron sends this automatically — see vercel.json) ---
CRON_SECRET=

# --- SMS (Termii) & WhatsApp (Meta Cloud API) — abandoned-checkout recovery ---
TERMII_API_KEY=
TERMII_SENDER_ID="BizNest"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Message template must be pre-approved in WhatsApp Manager under this exact
# name (see lib/whatsapp/send.ts) — outbound merchant-initiated messages
# outside a customer's 24h session window can't be free-form text.

# --- AI features (phase 5) ---
OPENAI_API_KEY=

# --- Vercel API (custom domains for Enterprise/Business Mogul stores) ---
# Vercel dashboard -> Account Settings -> Tokens (scope: this project) for VERCEL_API_TOKEN.
# VERCEL_PROJECT_ID is in Project Settings -> General. VERCEL_TEAM_ID only if the project is under a team.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Unsplash (optional upgrade for demo photography — works without this) ---
# Sample listings and store banners get real photos by default with zero
# config (via LoremFlickr). Set this for higher-quality, more relevant
# results instead — free key at https://unsplash.com/developers.
UNSPLASH_ACCESS_KEY=

# Webhook URL: 
# https://biznest.space/api/logistics/sendbox/webhook 
SENDBOX_WEBHOOK_SECRET=
