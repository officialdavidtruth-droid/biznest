# --- App ---
NEXT_PUBLIC_APP_URL=https://www.biznest.space

# --- SEO: search engine ownership verification ---
# Google Search Console -> Add property -> HTML tag. Paste ONLY the content="..." value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools -> HTML meta tag (msvalidate.01). Paste ONLY the content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Database (Supabase) ---
# DATABASE_URL: the pooled connection (port 6543, via PgBouncer) — used by the app at runtime.
# DIRECT_URL: the direct connection (port 5432) — used only for running migrations.
# Both come from Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL=
DIRECT_URL=postgresql://postgres.xxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# --- Auth.js ---
AUTH_SECRET=          
# Set to your real production URL once on a custom domain (biznest.space) —
# Auth.js validates the request host against this. Omit for localhost dev.
AUTH_URL=https://www.biznest.space
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Platform admin panel (/supaadmin) ---
# Single shared PIN, completely separate from the user/NextAuth system above
# — there's no per-person login here, just this one PIN. Pick any string.
ADMIN_PIN=
# Used to sign the admin session cookie (NOT the PIN itself). Generate with:
# openssl rand -hex 32
ADMIN_PIN_SECRET=

# --- Cloudinary (file uploads: KYC docs, product images, store logos) ---
# AI Store Builder — powers "Tell us about your business" onboarding
# generation on the Custom AI-Built Store plan. Get a key from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


PAYSTACK_SECRET_KEY=

FLUTTERWAVE_SECRET_KEY=
# Public key for the inline checkout (same value in both vars)
FLUTTERWAVE_PUBLIC_KEY=
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=

# Korapay public key (pk_...) -- enables the in-page Korapay popup. Without it, Korapay falls back to the hosted redirect.
KORAPAY_PUBLIC_KEY=
NEXT_PUBLIC_KORAPAY_PUBLIC_KEY=

# Payout calls (Korapay + Flutterwave transfers/balance) only work from whitelisted IPs, and Vercel has none.
# Point this at an HTTP forward proxy with a static IP, e.g. http://user:pass@203.0.113.10:3128,
# then whitelist that IP in the Kora and Flutterwave dashboards. Leave empty in sandbox.
PAYOUT_PROXY_URL=

# Static secret hash you set in the Flutterwave dashboard under
# Settings -> Webhooks — Flutterwave echoes it back on every webhook call
# via the verif-hash header so we can confirm the request is really theirs.
FLUTTERWAVE_SECRET_HASH=

# Encrypts the Paystack/Flutterwave keys store owners save for their own
# payment gateway. Any long random string (openssl rand -hex 32). If unset,
# AUTH_SECRET is used. Don't change it once stores have saved keys, or those
# keys can no longer be decrypted and must be re-entered.
STORE_GATEWAY_ENCRYPTION_KEY=
# Webhook URLs to configure on each provider's dashboard, once deployed:
#   Paystack:     https://<yourdomain>/api/payments/paystack/webhook
#   Flutterwave:  https://<yourdomain>/api/payments/flutterwave/webhook
# Paystack signs its webhook body with your PAYSTACK_SECRET_KEY automatically
# (no separate hash to configure) — just point the dashboard at the URL above.

# --- Logistics (Sendbox) ---
# Dashboard: https://app.sendbox.co -> your app -> Authentication
# SENDBOX_ENV picks the base URL in lib/logistics/sendbox.ts:
#   "sandbox" (default, any value other than "live") -> https://sandbox.staging.sendbox.co
#   "live"                                            -> https://live.sendbox.co
SENDBOX_ENV=sandbox
SENDBOX_CLIENT_SECRET=
# NOTE: paste this fresh from your Sendbox dashboard — it's a short-lived JWT
# and the one in your screenshot may be expired/rotated by the time you deploy.
SENDBOX_ACCESS_TOKEN=
SENDBOX_REFRESH_TOKEN=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="BizNest <no-reply@biznest.space>"

# --- Web Push (VAPID) — order/abandoned-checkout alerts to merchant devices ---
# Generate with: npx web-push generate-vapid-keys
# Public key is exposed to the browser on purpose (that's how Web Push works —
# it's not a secret, it just identifies this deployment to the push service).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:biznestspace2@gmail.com"

# --- Cron auth (Vercel Cron sends this automatically — see vercel.json) ---
CRON_SECRET=c052b2b7481d0ec8b9a91cdc391cbcabc2e198f2857ef5ebb76f4607195ce470

# --- SMS (Termii) & WhatsApp (Meta Cloud API) — abandoned-checkout recovery ---
TERMII_API_KEY=
TERMII_SENDER_ID="BizNest"
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Message template must be pre-approved in WhatsApp Manager under this exact
# name (see lib/whatsapp/send.ts) — outbound merchant-initiated messages
# outside a customer's 24h session window can't be free-form text.

# --- AI features (phase 5) ---
OPENAI_API_KEY=

# --- Vercel API (custom domains for Enterprise/Business Mogul stores) ---
# Vercel dashboard -> Account Settings -> Tokens (scope: this project) for VERCEL_API_TOKEN.
# VERCEL_PROJECT_ID is in Project Settings -> General. VERCEL_TEAM_ID only if the project is under a team.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Unsplash (optional upgrade for demo photography — works without this) ---
# Sample listings and store banners get real photos by default with zero
# config (via LoremFlickr). Set this for higher-quality, more relevant
# results instead — free key at https://unsplash.com/developers.
UNSPLASH_ACCESS_KEY=

# --- Sendbox webhook ---
# Configure this URL in Sendbox dashboard -> Webhooks:
# https://biznest.space/api/logistics/sendbox/webhook
SENDBOX_WEBHOOK_SECRET=

# Optional: self-host default stock photos. Run `node scripts/fetch-default-images.mjs`, then set to /defaults
NEXT_PUBLIC_DEFAULT_IMAGE_BASE_URL=

# --- Monitoring & alerting (see docs/OPERATIONS.md) ---
# Sentry: create a Next.js project at sentry.io, copy its DSN into BOTH vars (same value).
# Everything below is a no-op until the DSN is set.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build-time only (source maps so stack traces are readable). Org slug, project slug, and an
# auth token from sentry.io -> Settings -> Developer Settings -> Organization Tokens.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Where alerts go. Set at least one. Telegram gives an instant phone push.
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secret for /api/health/crons?key=... (point UptimeRobot / Better Stack at it).
# openssl rand -hex 24
HEALTH_CHECK_KEY=

# --- Tailoring: automatic customer updates on stage changes ---
# Uses the WhatsApp + Termii (SMS) credentials above. Meta only lets a business START a chat with an approved
# template, so create one in WhatsApp Manager with FOUR body variables and put its exact name here:
#   "Hi {{1}}, update on your {{2}}: {{3}} Track it here: {{4}}"
#   {{1}} customer first name, {{2}} garment and job number, {{3}} what the new stage means, {{4}} status link
# Without it, WhatsApp is tried as plain text (only works inside an open 24h chat) and SMS covers the rest.
WHATSAPP_TAILORING_TEMPLATE=
